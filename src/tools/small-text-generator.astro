---
import { STYLES } from '../lib/small-text';
---
<div id="st" class="space-y-4">
  <div><label for="st-in" class="label">Your text</label><input id="st-in" class="input !min-h-14 text-lg" value="small text" maxlength="300" autocomplete="off" /></div>
  <p class="hint">Tap a style to copy it. Not every letter has a tiny version in Unicode; missing ones stay normal size.</p>
  <ul class="grid gap-2 sm:grid-cols-2" data-list aria-live="polite">{STYLES.map(([n, fn], i) => <li><button type="button" data-i={i} class="card group flex w-full items-center gap-3 p-4 text-left hover:border-line-strong"><span class="min-w-0 flex-1"><span class="block text-xs font-semibold uppercase tracking-wide text-subtle">{n}</span><span class="mt-1 block truncate text-2xl">{fn('small text')}</span></span><span class="badge flex-none group-data-[copied]:!bg-success-soft group-data-[copied]:!text-success" data-label>Copy</span></button></li>)}</ul>
</div>
<script>
  import { copyText } from '../lib/ui';
  import { STYLES } from '../lib/small-text';
  const input = document.getElementById('st-in') as HTMLInputElement, list = document.querySelector<HTMLElement>('#st [data-list]')!;
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  function render() {
    const t = input.value || 'small text';
    list.innerHTML = STYLES.map(([n, fn], i) => `<li><button type="button" data-i="${i}" class="card group flex w-full items-center gap-3 p-4 text-left hover:border-line-strong"><span class="min-w-0 flex-1"><span class="block text-xs font-semibold uppercase tracking-wide text-subtle">${n}</span><span class="mt-1 block truncate text-2xl">${esc(fn(t))}</span></span><span class="badge flex-none group-data-[copied]:!bg-success-soft group-data-[copied]:!text-success" data-label>Copy</span></button></li>`).join('');
  }
  list.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]'); if (b) copyText(STYLES[Number(b.dataset.i)][1](input.value || 'small text'), b); });
  input.addEventListener('input', render); if (input.value !== 'small text') render();
</script>
