---
import Dropzone from '../components/Dropzone.astro';
import Icon from '../components/Icon.astro';
---
<div id="cl" class="space-y-5">
  <div data-step="pick"><Dropzone id="cl-drop" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp,.heic,.heif" formats="2 to 9 photos (JPG, PNG, WebP, HEIC)" maxLabel="50 MB each" multiple label="Choose photos" icon="LayoutGrid" /></div>
  <div class="alert alert-error" data-error hidden role="alert"><span data-msg></span></div>
  <div data-step="edit" class="grid gap-5 md:grid-cols-[minmax(0,1fr)_300px] md:items-start" hidden>
    <div class="card p-3 sm:p-4">
      <canvas data-preview class="mx-auto block h-auto max-h-[70vh] max-w-full rounded-md" role="img" aria-label="Collage preview"></canvas>
      <div class="mt-3 flex flex-wrap gap-2" data-thumbs></div>
      <p class="mt-1 text-sm text-subtle">Tap a photo to move it one place earlier. Use the cross to remove it.</p>
    </div>
    <div class="card space-y-5 p-5 md:sticky md:top-24">
      <div><label for="cl-layout" class="label">Layout</label><select id="cl-layout" class="select" data-layouts></select></div>
      <div><label for="cl-size" class="label">Size</label><select id="cl-size" class="select"><option value="1080x1080">Square 1080 × 1080</option><option value="1080x1350">Portrait 1080 × 1350</option><option value="1080x1920">Story 1080 × 1920</option><option value="1920x1080">Landscape 1920 × 1080</option><option value="2400x1800">Print 2400 × 1800</option></select></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label for="cl-gap" class="label">Spacing</label><input id="cl-gap" type="range" min="0" max="60" value="16" class="h-11 w-full accent-[var(--brand)]" /></div>
        <div><label for="cl-rad" class="label">Corners</label><input id="cl-rad" type="range" min="0" max="60" value="12" class="h-11 w-full accent-[var(--brand)]" /></div>
      </div>
      <div><label for="cl-bg" class="label">Background</label><input id="cl-bg" type="color" value="#ffffff" class="h-11 w-full cursor-pointer rounded-[10px] border border-line-strong bg-surface p-1" /></div>
      <label class="btn btn-secondary relative w-full cursor-pointer"><Icon name="Plus" size={18} />Add photos<input type="file" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp,.heic,.heif" class="absolute inset-0 cursor-pointer opacity-0" data-add /></label>
      <button type="button" class="btn btn-primary btn-lg w-full" data-download><Icon name="Download" size={20} />Download collage</button>
      <button type="button" class="btn btn-ghost w-full" data-reset><Icon name="RotateCcw" size={18} />Start over</button>
    </div>
  </div>
</div>
<script>
  import { initDropzone } from '../lib/dropzone';
  import { decodeAny, fitWithin, drawToCanvas, toBlob, type Decoded } from '../lib/image';
  import { downloadBlob, showError } from '../lib/ui';
  type Cell = [number, number, number, number]; // x, y, w, h in 0..1
  const grid = (cols: number, rows: number): Cell[] => Array.from({ length: cols * rows }, (_, i) => [(i % cols) / cols, Math.floor(i / cols) / rows, 1 / cols, 1 / rows]);
  const LAYOUTS: Record<number, [string, Cell[]][]> = {
    2: [['Side by side', grid(2, 1)], ['Stacked', grid(1, 2)]],
    3: [['Big left, two right', [[0, 0, 0.5, 1], [0.5, 0, 0.5, 0.5], [0.5, 0.5, 0.5, 0.5]]], ['Big top, two below', [[0, 0, 1, 0.6], [0, 0.6, 0.5, 0.4], [0.5, 0.6, 0.5, 0.4]]], ['Three columns', grid(3, 1)], ['Three rows', grid(1, 3)]],
    4: [['Grid 2 × 2', grid(2, 2)], ['Big top, three below', [[0, 0, 1, 0.62], [0, 0.62, 1 / 3, 0.38], [1 / 3, 0.62, 1 / 3, 0.38], [2 / 3, 0.62, 1 / 3, 0.38]]], ['Big left, three right', [[0, 0, 0.62, 1], [0.62, 0, 0.38, 1 / 3], [0.62, 1 / 3, 0.38, 1 / 3], [0.62, 2 / 3, 0.38, 1 / 3]]]],
    5: [['Two top, three below', [[0, 0, 0.5, 0.55], [0.5, 0, 0.5, 0.55], [0, 0.55, 1 / 3, 0.45], [1 / 3, 0.55, 1 / 3, 0.45], [2 / 3, 0.55, 1 / 3, 0.45]]], ['Big center left', [[0, 0, 0.6, 1], [0.6, 0, 0.4, 0.25], [0.6, 0.25, 0.4, 0.25], [0.6, 0.5, 0.4, 0.25], [0.6, 0.75, 0.4, 0.25]]]],
    6: [['Grid 3 × 2', grid(3, 2)], ['Grid 2 × 3', grid(2, 3)]],
    7: [['One big, six small', [[0, 0, 1, 0.5], ...grid(3, 2).map(([x, y, w, h]) => [x, 0.5 + y * 0.5, w, h * 0.5] as Cell)]]],
    8: [['Grid 4 × 2', grid(4, 2)], ['Grid 2 × 4', grid(2, 4)]],
    9: [['Grid 3 × 3', grid(3, 3)]],
  };
  const root = document.getElementById('cl')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const pv = q<HTMLCanvasElement>('[data-preview]'), layoutSel = q<HTMLSelectElement>('[data-layouts]'), err = q('[data-error]');
  let imgs: { d: Decoded; url: string }[] = [];

  function layouts() { const n = Math.min(9, Math.max(2, imgs.length)); const prev = layoutSel.value; layoutSel.innerHTML = LAYOUTS[n].map(([l], i) => `<option value="${i}">${l}</option>`).join(''); if (Number(prev) < LAYOUTS[n].length) layoutSel.value = prev; }
  function render(scale: number) {
    const [W, H] = $('cl-size').value.split('x').map((v) => Number(v) * scale);
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const g = c.getContext('2d')!; g.fillStyle = $('cl-bg').value; g.fillRect(0, 0, W, H); g.imageSmoothingQuality = 'high';
    const cells = LAYOUTS[Math.min(9, Math.max(2, imgs.length))][Number(layoutSel.value) || 0][1];
    const gap = (Number($('cl-gap').value) / 1080) * Math.min(W, H) * 1.2, rad = (Number($('cl-rad').value) / 1080) * Math.min(W, H);
    cells.forEach(([x, y, w, h], i) => {
      const im = imgs[i]; if (!im) return;
      // Equal spacing: gap around the edge and between photos
      const X = gap + x * (W - gap), Y = gap + y * (H - gap), CW = w * (W - gap) - gap, CH = h * (H - gap) - gap;
      g.save(); g.beginPath(); const r = Math.min(rad, CW / 2, CH / 2);
      g.moveTo(X + r, Y); g.arcTo(X + CW, Y, X + CW, Y + CH, r); g.arcTo(X + CW, Y + CH, X, Y + CH, r); g.arcTo(X, Y + CH, X, Y, r); g.arcTo(X, Y, X + CW, Y, r); g.clip();
      const s = Math.max(CW / im.d.width, CH / im.d.height), dw = im.d.width * s, dh = im.d.height * s; // cover the cell
      g.drawImage(im.d.source, X + (CW - dw) / 2, Y + (CH - dh) / 2, dw, dh);
      g.restore();
    });
    return c;
  }
  function draw() {
    const out = render(Math.min(1, 900 / Math.max(...$('cl-size').value.split('x').map(Number))));
    pv.width = out.width; pv.height = out.height; pv.getContext('2d')!.drawImage(out, 0, 0);
    q('[data-thumbs]').innerHTML = imgs.map((im, i) => `<div class="relative"><button type="button" class="block h-14 w-14 overflow-hidden rounded-md border border-line" data-up="${i}" aria-label="Move photo ${i + 1} earlier"><img src="${im.url}" alt="" class="h-full w-full object-cover" /></button><button type="button" class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-[#dc2626] text-white" data-del="${i}" aria-label="Remove photo ${i + 1}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>`).join('');
  }
  async function add(files: File[]) {
    showError(err, null);
    const room = 9 - imgs.length;
    if (files.length > room) showError(err, `A collage can have up to 9 photos, so only the first ${room} were added.`);
    for (const f of files.slice(0, room)) {
      try { const d = await decodeAny(f), { width, height } = fitWithin(d.width, d.height, 2400, 2400); const c = drawToCanvas(d, width, height); d.close?.(); imgs.push({ d: { source: c, width, height }, url: URL.createObjectURL(f) }); }
      catch { showError(err, `“${f.name}” could not be opened.`); }
    }
    if (imgs.length < 2) { showError(err, 'Choose at least two photos to make a collage.'); return; }
    q('[data-step=pick]').hidden = true; q('[data-step=edit]').hidden = false;
    layouts(); draw();
  }
  q('[data-thumbs]').addEventListener('click', (e) => {
    const t = e.target as HTMLElement, up = t.closest<HTMLElement>('[data-up]'), del = t.closest<HTMLElement>('[data-del]');
    if (del) { const [r] = imgs.splice(Number(del.dataset.del), 1); URL.revokeObjectURL(r.url); if (imgs.length < 2) { showError(err, 'A collage needs at least two photos. Add another one.'); } layouts(); draw(); }
    else if (up) { const i = Number(up.dataset.up); if (i > 0) { [imgs[i - 1], imgs[i]] = [imgs[i], imgs[i - 1]]; draw(); } }
  });
  root.addEventListener('input', (e) => { if (!(e.target as HTMLElement).closest('[data-step=pick]') && !(e.target as HTMLElement).matches('[data-add]')) draw(); });
  const addIn = q<HTMLInputElement>('[data-add]');
  addIn.addEventListener('change', () => { add(Array.from(addIn.files ?? [])); addIn.value = ''; });
  q('[data-download]').addEventListener('click', async () => {
    if (imgs.length < 2) return showError(err, 'A collage needs at least two photos.');
    downloadBlob(await toBlob(render(1), 'image/jpeg', 0.92), `collage-${$('cl-size').value}.jpg`);
  });
  q('[data-reset]').addEventListener('click', () => { imgs.forEach((i) => URL.revokeObjectURL(i.url)); imgs = []; q('[data-step=edit]').hidden = true; q('[data-step=pick]').hidden = false; showError(err, null); });
  initDropzone(document.getElementById('cl-drop')!, {
    accept: ['image/jpeg', 'image/png', 'image/webp', '.jpg', '.jpeg', '.png', '.webp', '.heic', '.heif'], multiple: true, maxBytes: 50 * 1024 * 1024,
    onFiles: add, onError: (m) => showError(err, m || null),
  });
</script>
