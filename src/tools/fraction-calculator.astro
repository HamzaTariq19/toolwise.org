---
import CalcLayout from '../components/CalcLayout.astro';
---
<CalcLayout id="fc">
  <Fragment slot="inputs">
    <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
      <div><label for="fc-a" class="label">First fraction</label><input id="fc-a" class="input text-center text-lg tabular" value="1 1/2" autocomplete="off" /></div>
      <div><label for="fc-op" class="sr-only">Operation</label><select id="fc-op" class="select !w-16 text-center text-lg"><option value="+">+</option><option value="-">−</option><option value="*">×</option><option value="/">÷</option></select></div>
      <div><label for="fc-b" class="label">Second fraction</label><input id="fc-b" class="input text-center text-lg tabular" value="2/3" autocomplete="off" /></div>
    </div>
    <p class="hint">Type fractions like <code>3/4</code>, mixed numbers like <code>2 1/3</code>, whole numbers like <code>5</code> or decimals like <code>0.25</code>.</p>
  </Fragment>
  <Fragment slot="results">
    <div data-ok hidden>
      <p class="text-sm font-medium text-muted">Result</p>
      <p class="mt-1 text-4xl font-extrabold tracking-tight tabular" data-r="main"></p>
      <dl class="mt-4 grid grid-cols-2 gap-3">
        <div class="stat"><dt class="stat-label">Mixed number</dt><dd class="text-lg font-bold tabular" data-r="mixed"></dd></div>
        <div class="stat"><dt class="stat-label">Decimal</dt><dd class="text-lg font-bold tabular" data-r="dec"></dd></div>
      </dl>
      <p class="mt-4 text-sm font-semibold">Steps</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-[0.9375rem] tabular" data-r="steps"></ol>
    </div>
    <div data-empty class="py-8 text-center text-muted">Enter two fractions.</div>
    <p class="alert alert-error" data-msg hidden role="alert"></p>
  </Fragment>
</CalcLayout>
<script>
  import { live, resultsUi, val } from '../lib/calc';
  const root = document.getElementById('fc')!, ui = resultsUi(root);
  type F = [number, number];
  const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : Math.abs(a));
  const simp = ([n, d]: F): F => { if (d < 0) { n = -n; d = -d; } const g = gcd(n, d) || 1; return [n / g, d / g]; };
  const show = ([n, d]: F) => (d === 1 ? `${n}` : `${n}/${d}`);
  function parse(s: string): F | null {
    s = s.trim().replace(/\s+/g, ' ').replace('−', '-');
    let m = s.match(/^(-)?(\d+) (\d+)\/(\d+)$/);
    if (m) { const d = +m[4]; if (!d) return null; return [(m[1] ? -1 : 1) * (+m[2] * d + +m[3]), d]; }
    m = s.match(/^(-?\d+)\/(-?\d+)$/);
    if (m) return +m[2] ? [+m[1], +m[2]] : null;
    m = s.match(/^-?\d*\.?\d+$/);
    if (m) { const dec = (s.split('.')[1] ?? '').length, d = 10 ** dec; return [Math.round(Number(s) * d), d]; }
    return null;
  }
  function calc() {
    const A = val('fc-a'), B = val('fc-b'), op = val('fc-op');
    if (!A.trim() || !B.trim()) return ui.empty();
    const a = parse(A), b = parse(B);
    if (!a) return ui.fail(`“${A}” is not a fraction I can read. Try 3/4, 1 1/2 or 0.5. The bottom number cannot be 0.`);
    if (!b) return ui.fail(`“${B}” is not a fraction I can read. Try 3/4, 1 1/2 or 0.5. The bottom number cannot be 0.`);
    const steps: string[] = [`Write as fractions: ${show(a)} and ${show(b)}`];
    let r: F;
    if (op === '+' || op === '-') {
      const l = (a[1] * b[1]) / gcd(a[1], b[1]), an = a[0] * (l / a[1]), bn = b[0] * (l / b[1]);
      if (a[1] !== b[1]) steps.push(`Common denominator ${l}: ${an}/${l} ${op === '+' ? '+' : '−'} ${bn}/${l}`);
      r = [op === '+' ? an + bn : an - bn, l]; steps.push(`${op === '+' ? 'Add' : 'Subtract'} the tops: ${r[0]}/${l}`);
    } else if (op === '*') { r = [a[0] * b[0], a[1] * b[1]]; steps.push(`Multiply tops and bottoms: (${a[0]} × ${b[0]}) / (${a[1]} × ${b[1]}) = ${r[0]}/${r[1]}`); }
    else { if (b[0] === 0) return ui.fail('You cannot divide by zero.'); r = [a[0] * b[1], a[1] * b[0]]; steps.push(`Flip the second fraction and multiply: ${show(a)} × ${b[1]}/${b[0]} = ${r[0]}/${r[1]}`); }
    const s = simp(r);
    if (s[0] !== r[0] || s[1] !== r[1]) steps.push(`Simplify by dividing by ${Math.abs(r[0] / s[0]) || 1}: ${show(s)}`);
    if (!Number.isSafeInteger(s[0]) || !Number.isSafeInteger(s[1])) return ui.fail('These numbers are too large to calculate exactly.');
    const whole = Math.trunc(s[0] / s[1]), rem = Math.abs(s[0] % s[1]);
    ui.show(); ui.set('main', show(s));
    ui.set('mixed', s[1] === 1 ? `${s[0]}` : whole ? `${whole} ${rem}/${s[1]}` : `${s[0] < 0 ? '-' : ''}${rem}/${s[1]}`);
    ui.set('dec', String(Math.round((s[0] / s[1]) * 1e10) / 1e10));
    ui.html('steps', steps.map((x) => `<li>${x.replace(/</g, '&lt;')}</li>`).join(''));
  }
  live(root.querySelector('[data-inputs]')!, calc);
</script>
