---
import Icon from '../components/Icon.astro';
import { p2, dateRows, tsRows, UNIT_S } from '../lib/timestamp';
// Build-time sample so the page has its full height before the script runs (the script swaps in the current time).
const B = new Date(); B.setUTCSeconds(0, 0); const bs = Math.floor(B.getTime() / 1000);
const bDate = `${B.getUTCFullYear()}-${p2(B.getUTCMonth() + 1)}-${p2(B.getUTCDate())}`, bTime = `${p2(B.getUTCHours())}:${p2(B.getUTCMinutes())}:00`;
---
<div id="ts" class="space-y-5">
  <section class="card flex flex-wrap items-center justify-between gap-3 p-4"><div><p class="text-sm text-muted">Current Unix time</p><p class="mono text-2xl font-bold tabular" data-now>{bs}</p></div><button type="button" class="btn btn-secondary btn-sm" data-copy-now><Icon name="Copy" size={16} /><span data-label>Copy</span></button></section>
  <div class="grid gap-5 md:grid-cols-2 md:items-start">
    <section class="card space-y-4 p-5">
      <h2 class="text-base font-semibold">Timestamp to date</h2>
      <div><label for="ts-in" class="label">Unix timestamp</label><input id="ts-in" class="input mono text-lg" inputmode="numeric" autocomplete="off" value={bs} /><p class="hint" data-unit>{UNIT_S}</p></div>
      <p class="alert alert-error" data-err hidden></p>
      <dl class="space-y-2 text-[0.9375rem]" data-out set:html={dateRows(bs * 1000, { locale: 'en-US', timeZone: 'UTC', nowMs: bs * 1000 })}></dl>
    </section>
    <section class="card space-y-4 p-5">
      <h2 class="text-base font-semibold">Date to timestamp</h2>
      <div class="grid grid-cols-2 gap-3"><div><label for="ts-d" class="label">Date</label><input id="ts-d" type="date" class="input" value={bDate} /></div><div><label for="ts-t" class="label">Time</label><input id="ts-t" type="time" step="1" class="input" value={bTime} /></div></div>
      <fieldset><legend class="label">Time zone</legend><div class="segmented"><label><input type="radio" name="ts-z" value="local" checked /><span>My local time</span></label><label><input type="radio" name="ts-z" value="utc" /><span>UTC</span></label></div></fieldset>
      <dl class="space-y-2 text-[0.9375rem]" data-out2 set:html={tsRows(B.getTime())}></dl>
    </section>
  </div>
</div>
<script>
  import { copyText } from '../lib/ui';
  const root = document.getElementById('ts')!, q = (s: string) => root.querySelector<HTMLElement>(s)!;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  import { p2, dateRows, tsRows } from '../lib/timestamp';
  function toDate() {
    const raw = $('ts-in').value.trim(), err = q('[data-err]'); err.hidden = true;
    if (!raw) { q('[data-out]').innerHTML = ''; return; }
    if (!/^-?\d+(\.\d+)?$/.test(raw)) { err.hidden = false; err.textContent = 'A Unix timestamp is a number, like 1767225600.'; q('[data-out]').innerHTML = ''; return; }
    const n = Number(raw), digits = raw.replace(/^-|\..*$/g, '').length;
    const unit = digits > 16 ? 'µs' : digits > 13 ? 'µs?' : digits > 11 ? 'ms' : 's';
    const ms = unit === 's' ? n * 1000 : unit === 'ms' ? n : n / 1000;
    const d = new Date(ms);
    if (isNaN(d.getTime())) { err.hidden = false; err.textContent = 'That timestamp is out of range.'; return; }
    q('[data-unit]').textContent = `Read as ${unit === 's' ? 'seconds' : unit === 'ms' ? 'milliseconds' : 'microseconds'} since 1 January 1970 (UTC).`;
    q('[data-out]').innerHTML = dateRows(ms);
  }
  function toTs() {
    if (!$('ts-d').value) { q('[data-out2]').innerHTML = ''; return; }
    const [y, m, d] = $('ts-d').value.split('-').map(Number), [h = 0, mi = 0, s = 0] = ($('ts-t').value || '00:00:00').split(':').map(Number);
    const utc = (root.querySelector('input[name=ts-z]:checked') as HTMLInputElement).value === 'utc';
    const ms = utc ? Date.UTC(y, m - 1, d, h, mi, s) : new Date(y, m - 1, d, h, mi, s).getTime();
    q('[data-out2]').innerHTML = tsRows(ms);
  }
  const now = new Date();
  $('ts-in').value = String(Math.floor(now.getTime() / 1000));
  $('ts-d').value = `${now.getFullYear()}-${p2(now.getMonth() + 1)}-${p2(now.getDate())}`; $('ts-t').value = `${p2(now.getHours())}:${p2(now.getMinutes())}:00`;
  const tick = () => (q('[data-now]').textContent = String(Math.floor(Date.now() / 1000)));
  tick(); setInterval(tick, 1000);
  $('ts-in').addEventListener('input', toDate); root.addEventListener('input', (e) => { if (e.target !== $('ts-in')) toTs(); }); root.addEventListener('change', toTs);
  root.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]'); if (b) copyText(b.dataset.copy!, b); });
  q('[data-copy-now]').addEventListener('click', (e) => copyText(q('[data-now]').textContent ?? '', e.currentTarget as HTMLElement));
  toDate(); toTs();
</script>
