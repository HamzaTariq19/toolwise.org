---
import Icon from '../components/Icon.astro';
---
<div id="tw" class="grid gap-5 lg:grid-cols-[1fr_300px] lg:items-start">
  <div class="space-y-4">
    <div class="card p-4 sm:p-5">
      <label for="tw-in" class="label">Your post</label>
      <textarea id="tw-in" class="textarea !min-h-[200px] text-[1.0625rem]" placeholder="What's happening?">Just tried toolwise.org to compress a PDF in my browser 🚀 No signup, nothing uploaded. Highly recommend! #productivity</textarea>
      <div class="mt-3 flex items-center gap-3">
        <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15" fill="none" stroke="var(--surface-2)" stroke-width="4"/><circle cx="18" cy="18" r="15" fill="none" stroke-width="4" stroke-linecap="round" transform="rotate(-90 18 18)" stroke-dasharray="94.25" data-ring/></svg>
        <p class="text-lg font-bold tabular" data-count aria-live="polite"></p>
        <button type="button" class="btn btn-secondary btn-sm ml-auto" data-copy><Icon name="Copy" size={16} /><span data-label>Copy</span></button>
      </div>
    </div>
    <section class="card p-4 sm:p-5" data-thread-wrap hidden>
      <div class="flex items-center justify-between"><h2 class="text-base font-semibold">Split into a thread</h2><label class="flex items-center gap-2 text-sm"><input type="checkbox" id="tw-num" class="h-5 w-5 accent-[var(--brand)]" checked />Add 1/3 numbers</label></div>
      <ol class="mt-3 space-y-3" data-thread></ol>
    </section>
  </div>
  <aside class="card space-y-3 p-5 lg:sticky lg:top-24">
    <div class="stat"><p class="stat-label">Characters left</p><p class="stat-value" data-left></p></div>
    <dl class="grid grid-cols-2 gap-2 text-sm">
      <div class="stat"><dt class="stat-label">Words</dt><dd class="font-bold tabular" data-k="words"></dd></div>
      <div class="stat"><dt class="stat-label">Hashtags</dt><dd class="font-bold tabular" data-k="tags"></dd></div>
      <div class="stat"><dt class="stat-label">Mentions</dt><dd class="font-bold tabular" data-k="mentions"></dd></div>
      <div class="stat"><dt class="stat-label">Links</dt><dd class="font-bold tabular" data-k="links"></dd></div>
    </dl>
    <p class="text-sm text-muted">Counting follows X's rules: links always count as 23 characters, and emoji and most Chinese, Japanese and Korean characters count as 2.</p>
  </aside>
</div>
<script>
  import { copyText } from '../lib/ui';
  const root = document.getElementById('tw')!, ta = document.getElementById('tw-in') as HTMLTextAreaElement, q = (s: string) => root.querySelector<HTMLElement>(s)!;
  const LIMIT = 280, URL_RE = /\bhttps?:\/\/[^\s]+|\b(?:[a-z0-9-]+\.)+(?:com|org|net|io|co|ai|app|dev|uk|de|in|me|ly|gg|tv)(?:\/[^\s]*)?/gi;
  const seg = 'Segmenter' in Intl ? new (Intl as any).Segmenter(undefined, { granularity: 'grapheme' }) : null;
  const light = (cp: number) => (cp >= 0 && cp <= 4351) || (cp >= 8192 && cp <= 8205) || (cp >= 8208 && cp <= 8223) || (cp >= 8242 && cp <= 8247);
  /** Weighted length as counted by X (twitter-text v3 rules) */
  function weigh(text: string) {
    let n = 0;
    const s = text.normalize('NFC').replace(URL_RE, () => { n += 23; return ''; });
    const parts = seg ? Array.from(seg.segment(s) as Iterable<{ segment: string }>, (x) => x.segment) : Array.from(s);
    for (const g of parts) { if (/\p{Extended_Pictographic}|\p{Regional_Indicator}/u.test(g)) n += 2; else for (const ch of g) n += light(ch.codePointAt(0)!) ? 1 : 2; }
    return n;
  }
  function split(text: string) {
    const words = text.split(/(\s+)/), out: string[] = []; let cur = '';
    const room = q('#tw-num') && (document.getElementById('tw-num') as HTMLInputElement).checked ? LIMIT - 6 : LIMIT;
    for (const w of words) { if (weigh(cur + w) > room && cur.trim()) { out.push(cur.trim()); cur = w.trimStart(); } else cur += w; }
    if (cur.trim()) out.push(cur.trim());
    return out;
  }
  function run() {
    const t = ta.value, n = weigh(t), left = LIMIT - n;
    q('[data-count]').textContent = `${n} / ${LIMIT}`;
    q('[data-left]').textContent = String(left); q('[data-left]').classList.toggle('text-danger', left < 0);
    const ring = q('[data-ring]'); ring.setAttribute('stroke-dashoffset', String(94.25 * (1 - Math.min(1, n / LIMIT)))); ring.setAttribute('stroke', left < 0 ? '#dc2626' : left < 20 ? '#f59e0b' : 'var(--brand)');
    q('[data-k=words]').textContent = String((t.match(/\S+/g) ?? []).length); q('[data-k=tags]').textContent = String((t.match(/(^|\s)#[\p{L}\p{N}_]+/gu) ?? []).length);
    q('[data-k=mentions]').textContent = String((t.match(/(^|\s)@\w+/g) ?? []).length); q('[data-k=links]').textContent = String((t.match(URL_RE) ?? []).length);
    q('[data-thread-wrap]').hidden = left >= 0;
    if (left < 0) { const parts = split(t), num = (document.getElementById('tw-num') as HTMLInputElement).checked; q('[data-thread]').innerHTML = parts.map((p, i) => { const full = num ? `${p} ${i + 1}/${parts.length}` : p; return `<li class="rounded-lg bg-surface-2 p-3"><p class="whitespace-pre-wrap text-[0.9375rem]">${full.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)}</p><div class="mt-2 flex items-center justify-between text-sm text-muted"><span>${weigh(full)} / ${LIMIT}</span><button type="button" class="btn btn-ghost btn-sm" data-copy-part="${encodeURIComponent(full)}"><span data-label>Copy</span></button></div></li>`; }).join(''); }
  }
  ta.addEventListener('input', run); root.addEventListener('change', run);
  root.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-part]'); if (b) copyText(decodeURIComponent(b.dataset.copyPart!), b); });
  q('[data-copy]').addEventListener('click', (e) => copyText(ta.value, e.currentTarget as HTMLElement));
  run();
</script>
