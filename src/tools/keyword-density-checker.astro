---
---
<div id="kd" class="space-y-4">
  <div class="card space-y-4 p-4 sm:p-5">
    <div><label for="kd-text" class="label">Your content</label><textarea id="kd-text" class="textarea !min-h-[220px]" placeholder="Paste your article, page or product description…"></textarea></div>
    <div><label for="kd-kw" class="label">Target keyword or phrase (optional)</label><input id="kd-kw" class="input" placeholder="e.g. compress pdf" autocomplete="off" /></div>
  </div>
  <section class="card p-5" data-target hidden aria-live="polite">
    <p class="text-sm font-medium text-muted">Target keyword</p>
    <p class="mt-1 text-3xl font-extrabold tabular" data-r="dens"></p>
    <p class="mt-1 text-[0.9375rem]" data-r="advice"></p>
    <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2" data-r="placement"></ul>
  </section>
  <div class="grid gap-4 lg:grid-cols-3" data-tables></div>
  <p class="text-sm text-subtle" data-r="summary"></p>
</div>
<script>
  import { words } from '../lib/text-stats';
  import { fmt } from '../lib/ui';
  const STOP = new Set('a about above after again all also am an and any are as at be because been before being below between both but by can could did do does doing down during each few for from further had has have having he her here hers him his how i if in into is it its just me more most my no nor not now of off on once only or other our out over own same she should so some such than that the their them then there these they this those through to too under until up very was we were what when where which while who whom why will with would you your yours'.split(' '));
  const root = document.getElementById('kd')!, q = (s: string) => root.querySelector<HTMLElement>(s)!;
  const ta = document.getElementById('kd-text') as HTMLTextAreaElement, kw = document.getElementById('kd-kw') as HTMLInputElement;
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  function grams(ws: string[], n: number) {
    const m = new Map<string, number>();
    for (let i = 0; i + n <= ws.length; i++) { const g = ws.slice(i, i + n); if (STOP.has(g[0]) || STOP.has(g[n - 1]) || g.some((w) => /^\d+$/.test(w))) continue; const k = g.join(' '); m.set(k, (m.get(k) ?? 0) + 1); }
    return [...m].filter(([, c]) => n === 1 || c > 1).sort((a, b) => b[1] - a[1]).slice(0, 15);
  }
  function run() {
    const ws = words(ta.value).map((w) => w.toLowerCase().replace(/’/g, "'")), total = ws.length;
    q('[data-r=summary]').textContent = total ? `${fmt(total)} words analyzed. Density = times used × words in the phrase ÷ total words.` : '';
    q('[data-tables]').innerHTML = total ? [1, 2, 3].map((n) => { const rows = grams(ws, n); return `<section class="card overflow-hidden"><h2 class="border-b border-line px-4 py-2.5 text-sm font-semibold">${n === 1 ? 'Single words' : `${n}-word phrases`}</h2><table class="w-full text-sm tabular"><tbody class="divide-y divide-[var(--border)]">${rows.map(([k, c]) => `<tr><td class="px-4 py-1.5">${esc(k)}</td><td class="px-2 py-1.5 text-right text-muted">${c}×</td><td class="px-4 py-1.5 text-right font-semibold">${((c * n * 100) / total).toFixed(1)}%</td></tr>`).join('') || '<tr><td class="px-4 py-3 text-muted">No repeated phrases yet.</td></tr>'}</tbody></table></section>`; }).join('') : '';
    const target = words(kw.value).map((w) => w.toLowerCase());
    q('[data-target]').hidden = !target.length || !total;
    if (!target.length || !total) return;
    let count = 0; for (let i = 0; i + target.length <= ws.length; i++) if (target.every((w, j) => ws[i + j] === w)) count++;
    const d = (count * target.length * 100) / total;
    q('[data-r=dens]').textContent = `${d.toFixed(2)}% · used ${count} time${count === 1 ? '' : 's'}`;
    q('[data-r=advice]').textContent = count === 0 ? 'Your target phrase does not appear in the text. Use it naturally at least once, ideally near the start.' : d > 3 ? 'That is high. Repeating a phrase too often reads unnaturally and can look like keyword stuffing. Use synonyms and related terms instead.' : d < 0.5 && total > 300 ? 'That is fairly low. Consider mentioning the phrase where it fits naturally, such as in a heading or the first paragraph.' : 'That is a natural level. Focus on answering the reader\'s question well.';
    const text = ta.value.toLowerCase(), first = words(ta.value.split(/\n\s*\n/)[0] ?? '').map((w) => w.toLowerCase()).join(' '), phrase = target.join(' ');
    const checks: [boolean, string][] = [[first.includes(phrase), 'In the first paragraph'], [/^#{1,3} .*$/m.test(ta.value) ? new RegExp(`^#{1,3} .*${phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`, 'im').test(ta.value) : false, 'In a heading (lines starting with #)'], [count > 0 && text.lastIndexOf(phrase) > text.length * 0.6, 'Near the end'], [count >= 1 && d <= 3, 'Not overused']];
    q('[data-r=placement]').innerHTML = checks.map(([ok, l]) => `<li class="${ok ? 'text-success' : 'text-muted'}">${ok ? '✓' : '○'} ${l}</li>`).join('');
  }
  root.addEventListener('input', run); run();
</script>
