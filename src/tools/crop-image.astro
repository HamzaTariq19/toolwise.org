---
import ImageEditor from '../components/ImageEditor.astro';
const ratios = [['free', 'Free'], ['1', 'Square 1:1'], ['0.8', 'Portrait 4:5'], ['0.75', '3:4'], ['1.3333', '4:3'], ['1.7778', '16:9'], ['0.5625', 'Story 9:16'], ['orig', 'Original']];
---
<ImageEditor id="ci3" icon="Crop" downloadLabel="Download cropped image" hint="Drag the blue corners to resize the crop, or drag inside it to move it.">
  <div slot="overlay" class="pointer-events-none absolute inset-0" data-layer>
    <div class="pointer-events-auto absolute cursor-move outline outline-2 outline-[#2563eb] [box-shadow:0_0_0_9999px_rgb(15_23_42/0.5)]" data-box>
      <div class="pointer-events-none absolute inset-0 [background:linear-gradient(to_right,transparent_33.2%,rgb(255_255_255/.5)_33.3%,transparent_33.5%,transparent_66.5%,rgb(255_255_255/.5)_66.6%,transparent_66.8%),linear-gradient(to_bottom,transparent_33.2%,rgb(255_255_255/.5)_33.3%,transparent_33.5%,transparent_66.5%,rgb(255_255_255/.5)_66.6%,transparent_66.8%)]"></div>
      {['nw', 'ne', 'sw', 'se'].map((h) => <span class={`absolute h-7 w-7 rounded-full border-2 border-white bg-[#2563eb] ${h.includes('n') ? '-top-3.5' : '-bottom-3.5'} ${h.includes('w') ? '-left-3.5' : '-right-3.5'}`} data-h={h}></span>)}
    </div>
  </div>
  <div><label for="ci3-ratio" class="label">Shape</label><select id="ci3-ratio" class="select">{ratios.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
  <div class="grid grid-cols-2 gap-3">
    <div><label for="ci3-w" class="label">Width (px)</label><input id="ci3-w" class="input tabular" inputmode="numeric" /></div>
    <div><label for="ci3-h" class="label">Height (px)</label><input id="ci3-h" class="input tabular" inputmode="numeric" /></div>
  </div>
</ImageEditor>
<script>
  import { initImageEditor, makeCanvas } from '../lib/image-editor';
  import { num } from '../lib/ui';
  const root = document.getElementById('ci3')!;
  const box = root.querySelector<HTMLElement>('[data-box]')!, layer = root.querySelector<HTMLElement>('[data-layer]')!;
  const ratioSel = document.getElementById('ci3-ratio') as HTMLSelectElement, wIn = document.getElementById('ci3-w') as HTMLInputElement, hIn = document.getElementById('ci3-h') as HTMLInputElement;
  // Crop rectangle in original image pixels
  let r = { x: 0, y: 0, w: 1, h: 1 };
  const ratio = () => { const v = ratioSel.value; const img = ed.img!; return v === 'free' ? 0 : v === 'orig' ? img.width / img.height : Number(v); };

  const ed = initImageEditor('ci3', {
    suffix: 'cropped',
    onLoad: (img) => { r = { x: img.width * 0.1, y: img.height * 0.1, w: img.width * 0.8, h: img.height * 0.8 }; ratioSel.value = 'free'; requestAnimationFrame(place); },
    preview: (img, scale) => { const { c, g } = makeCanvas(img.width * scale, img.height * scale); g.drawImage(img.source, 0, 0, c.width, c.height); return c; },
    describe: () => `Crop: ${Math.round(r.w)} × ${Math.round(r.h)} px`,
    render: (img, scale) => { const { c, g } = makeCanvas(r.w * scale, r.h * scale); g.drawImage(img.source, r.x, r.y, r.w, r.h, 0, 0, c.width, c.height); return c; },
  });
  function place() {
    const img = ed.img; if (!img) return;
    const pv = ed.preview.getBoundingClientRect(), st = layer.getBoundingClientRect();
    if (!pv.width) return;
    const k = pv.width / img.width;
    box.style.left = `${pv.left - st.left + r.x * k}px`; box.style.top = `${pv.top - st.top + r.y * k}px`;
    box.style.width = `${r.w * k}px`; box.style.height = `${r.h * k}px`;
    wIn.value = String(Math.round(r.w)); hIn.value = String(Math.round(r.h));
    root.querySelector('[data-dims]')!.textContent = `Crop: ${Math.round(r.w)} × ${Math.round(r.h)} px`;
  }
  function clampRect() {
    const img = ed.img!;
    r.w = Math.min(Math.max(8, r.w), img.width); r.h = Math.min(Math.max(8, r.h), img.height);
    r.x = Math.min(Math.max(0, r.x), img.width - r.w); r.y = Math.min(Math.max(0, r.y), img.height - r.h);
  }
  function applyRatio() {
    const a = ratio(), img = ed.img; if (!a || !img) return;
    const cx = r.x + r.w / 2, cy = r.y + r.h / 2;
    let w = r.w, h = w / a; if (h > img.height) { h = img.height; w = h * a; } if (w > img.width) { w = img.width; h = w / a; }
    r = { x: cx - w / 2, y: cy - h / 2, w, h }; clampRect();
  }
  ratioSel.addEventListener('change', () => { applyRatio(); place(); });
  const fromInputs = (which: 'w' | 'h') => {
    const img = ed.img; if (!img) return; const a = ratio(), W = num(wIn.value), H = num(hIn.value);
    if (which === 'w' && W > 0) { r.w = Math.min(W, img.width); if (a) r.h = r.w / a; }
    if (which === 'h' && H > 0) { r.h = Math.min(H, img.height); if (a) r.w = r.h * a; }
    clampRect(); place(); ed.redraw();
  };
  wIn.addEventListener('change', () => fromInputs('w')); hIn.addEventListener('change', () => fromInputs('h'));
  let drag: { h: string; x: number; y: number; s: typeof r } | null = null;
  box.addEventListener('pointerdown', (e) => { e.preventDefault(); box.setPointerCapture(e.pointerId); drag = { h: (e.target as HTMLElement).dataset.h ?? 'move', x: e.clientX, y: e.clientY, s: { ...r } }; });
  box.addEventListener('pointermove', (e) => {
    if (!drag || !ed.img) return;
    const img = ed.img, k = ed.preview.getBoundingClientRect().width / img.width, dx = (e.clientX - drag.x) / k, dy = (e.clientY - drag.y) / k, s = drag.s, a = ratio();
    if (drag.h === 'move') { r.x = s.x + dx; r.y = s.y + dy; clampRect(); }
    else {
      let x1 = s.x, y1 = s.y, x2 = s.x + s.w, y2 = s.y + s.h;
      if (drag.h.includes('w')) x1 = Math.min(Math.max(0, x1 + dx), x2 - 8); else x2 = Math.max(Math.min(img.width, x2 + dx), x1 + 8);
      if (drag.h.includes('n')) y1 = Math.min(Math.max(0, y1 + dy), y2 - 8); else y2 = Math.max(Math.min(img.height, y2 + dy), y1 + 8);
      let w = x2 - x1, h = y2 - y1;
      if (a) { h = w / a; if (drag.h.includes('n')) y1 = y2 - h; else y2 = y1 + h; if (y1 < 0 || y2 > img.height) { h = drag.h.includes('n') ? y2 : img.height - y1; h = Math.max(8, h); w = h * a; if (drag.h.includes('w')) x1 = x2 - w; if (drag.h.includes('n')) y1 = y2 - h; } }
      r = { x: x1, y: y1, w, h }; clampRect();
    }
    place();
  });
  const end = () => { if (drag) { drag = null; ed.redraw(); } };
  box.addEventListener('pointerup', end); box.addEventListener('pointercancel', end);
  new ResizeObserver(place).observe(ed.preview);
  window.addEventListener('resize', place);
</script>
