---
import { colorViews } from '../lib/color-picker-view';
// Default color rendered at build time so the panels don't shift in when the script runs
const init = colorViews({ r: 29, g: 78, b: 216, a: 1 });
---
<div id="cpk" class="grid gap-5 md:grid-cols-[300px_1fr] md:items-start">
  <div class="card space-y-4 p-5">
    <label class="relative block h-40 w-full cursor-pointer overflow-hidden rounded-xl border border-line" style="background:#1D4ED8" data-swatch>
      <input type="color" id="cpk-native" value="#1d4ed8" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Open color picker" />
      <span class="absolute bottom-2 left-2 rounded-md bg-black/50 px-2 py-1 text-sm font-medium text-white">Tap to pick</span>
    </label>
    <div><label for="cpk-in" class="label">Or type any color</label><input id="cpk-in" class="input mono" value="#1D4ED8" placeholder="#1D4ED8, rgb(29 78 216), hsl(…), red" autocomplete="off" spellcheck="false" /></div>
    <p class="alert alert-error" data-err hidden></p>
    <div><div class="flex justify-between"><label for="cpk-a" class="label">Opacity</label><output class="text-sm font-semibold tabular" data-aout>100%</output></div><input id="cpk-a" type="range" min="0" max="100" value="100" class="h-11 w-full accent-[var(--brand)]" /></div>
  </div>
  <div class="space-y-5">
    <section class="card p-5"><h2 class="text-base font-semibold">Color codes</h2><ul class="mt-3 space-y-2" data-codes set:html={init.codes}></ul></section>
    <section class="card p-5"><h2 class="text-base font-semibold">Shades and tints</h2><div class="mt-3 grid grid-cols-9 overflow-hidden rounded-lg" data-shades set:html={init.shades}></div><p class="hint">Tap a swatch to use it.</p></section>
    <section class="card p-5"><h2 class="text-base font-semibold">Matching colors</h2><div class="mt-3 grid gap-3 sm:grid-cols-2" data-harmony set:html={init.harmony}></div></section>
    <section class="card p-5"><h2 class="text-base font-semibold">Text contrast (WCAG)</h2><div class="mt-3 grid gap-3 sm:grid-cols-2" data-contrast set:html={init.contrast}></div></section>
  </div>
</div>
<script>
  import { parseColor, toHex, type RGB } from '../lib/color';
  import { colorViews } from '../lib/color-picker-view';
  import { copyText, store } from '../lib/ui';
  const root = document.getElementById('cpk')!, native = document.getElementById('cpk-native') as HTMLInputElement, input = document.getElementById('cpk-in') as HTMLInputElement, alpha = document.getElementById('cpk-a') as HTMLInputElement;
  const q = (s: string) => root.querySelector<HTMLElement>(s)!;
  let cur: RGB = parseColor(store.get('tw-color', '#1D4ED8')) ?? { r: 29, g: 78, b: 216, a: 1 };
  function show(updateInput = true) {
    store.set('tw-color', toHex({ ...cur, a: 1 }));
    const hex = toHex(cur), solid = toHex({ ...cur, a: 1 });
    q('[data-swatch]').style.background = `linear-gradient(${hex},${hex}), repeating-conic-gradient(#ddd 0 25%, #fff 0 50%) 50%/16px 16px`;
    native.value = solid.toLowerCase();
    if (updateInput) input.value = hex;
    alpha.value = String(Math.round(cur.a * 100)); q('[data-aout]').textContent = `${alpha.value}%`;
    const v = colorViews(cur);
    q('[data-codes]').innerHTML = v.codes; q('[data-shades]').innerHTML = v.shades; q('[data-harmony]').innerHTML = v.harmony; q('[data-contrast]').innerHTML = v.contrast;
  }
  input.addEventListener('input', () => { const c = parseColor(input.value); q('[data-err]').hidden = !!c || !input.value.trim(); q('[data-err]').textContent = 'That color format is not recognized. Try #1D4ED8, rgb(29, 78, 216), hsl(224, 76%, 48%) or a name like teal.'; if (c) { cur = c; show(false); } });
  native.addEventListener('input', () => { cur = { ...parseColor(native.value)!, a: cur.a }; show(); });
  alpha.addEventListener('input', () => { cur = { ...cur, a: Number(alpha.value) / 100 }; show(); });
  root.addEventListener('click', (e) => { const t = e.target as HTMLElement, c = t.closest<HTMLElement>('[data-copy]'), u = t.closest<HTMLElement>('[data-use]'); if (c) copyText(c.dataset.copy!, c); if (u) { cur = parseColor(u.dataset.use!)!; show(); } });
  show();
</script>
