---
import Icon from '../components/Icon.astro';
---
<div id="tc" class="space-y-4">
  <div class="grid gap-4 lg:grid-cols-2">
    <div><label for="tc-a" class="label">Original text</label><textarea id="tc-a" class="textarea !min-h-[200px]" spellcheck="false" placeholder="Paste the first version…"></textarea></div>
    <div><label for="tc-b" class="label">Changed text</label><textarea id="tc-b" class="textarea !min-h-[200px]" spellcheck="false" placeholder="Paste the second version…"></textarea></div>
  </div>
  <div class="card flex flex-wrap items-center gap-x-6 gap-y-2 p-4">
    <div class="segmented"><label><input type="radio" name="tc-by" value="words" checked /><span>Compare words</span></label><label><input type="radio" name="tc-by" value="chars" /><span>Characters</span></label><label><input type="radio" name="tc-by" value="lines" /><span>Lines</span></label></div>
    <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="tc-case" class="h-5 w-5 accent-[var(--brand)]" />Ignore capital letters</label>
    <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="tc-ws" class="h-5 w-5 accent-[var(--brand)]" />Ignore extra spaces</label>
    <button type="button" class="btn btn-ghost btn-sm" data-swap><Icon name="ArrowLeftRight" size={16} />Swap</button>
  </div>
  <section class="card p-4 sm:p-5" aria-live="polite">
    <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="text-base font-semibold">Differences</h2><p class="text-sm" data-summary></p></div>
    <div class="mt-3 flex flex-wrap gap-4 text-sm text-muted"><span><span class="tc-del px-1">removed</span></span><span><span class="tc-add px-1">added</span></span></div>
    <div class="mt-3 max-h-[60vh] min-h-24 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-surface-2 p-4 text-[0.9375rem] leading-relaxed" data-out>Paste text in both boxes to see the differences.</div>
  </section>
</div>
<style is:global>
  .tc-del { background: #fee2e2; color: #991b1b; text-decoration: line-through; text-decoration-color: rgb(153 27 27 / .5); border-radius: 3px; }
  .tc-add { background: #dcfce7; color: #166534; border-radius: 3px; }
  .dark .tc-del { background: rgb(248 113 113 / .2); color: #fca5a5; }
  .dark .tc-add { background: rgb(74 222 128 / .18); color: #86efac; }
</style>
<script>
  const root = document.getElementById('tc')!;
  const a = document.getElementById('tc-a') as HTMLTextAreaElement, b = document.getElementById('tc-b') as HTMLTextAreaElement;
  const out = root.querySelector<HTMLElement>('[data-out]')!;
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  let lib: typeof import('diff') | null = null;
  let t: number | undefined;
  async function run() {
    if (!a.value && !b.value) { out.textContent = 'Paste text in both boxes to see the differences.'; root.querySelector('[data-summary]')!.textContent = ''; return; }
    lib ??= await import('diff');
    const by = (root.querySelector('input[name=tc-by]:checked') as HTMLInputElement).value;
    const ic = (document.getElementById('tc-case') as HTMLInputElement).checked, ws = (document.getElementById('tc-ws') as HTMLInputElement).checked;
    const norm = (s: string) => (ws ? s.replace(/[ \t]+/g, ' ').replace(/ *\n */g, '\n').trim() : s);
    const A = norm(a.value), B = norm(b.value);
    const parts = by === 'lines' ? lib.diffLines(A, B, { ignoreCase: ic } as Parameters<typeof lib.diffChars>[2] as never) : by === 'chars' ? lib.diffChars(A, B, { ignoreCase: ic }) : lib.diffWordsWithSpace(A, B, { ignoreCase: ic });
    let add = 0, del = 0;
    out.innerHTML = (parts ?? []).map((p) => { if (p.added) { add += p.count ?? 1; return `<ins class="tc-add no-underline">${esc(p.value)}</ins>`; } if (p.removed) { del += p.count ?? 1; return `<del class="tc-del">${esc(p.value)}</del>`; } return esc(p.value); }).join('');
    const unit = by === 'lines' ? 'line' : by === 'chars' ? 'character' : 'word';
    root.querySelector('[data-summary]')!.innerHTML = !add && !del ? '<span class="font-semibold text-success">✓ The texts are identical</span>' : `<span class="text-success">+${add} ${unit}${add === 1 ? '' : 's'} added</span> · <span class="text-danger">−${del} removed</span>`;
  }
  const schedule = () => { clearTimeout(t); t = window.setTimeout(run, (a.value.length + b.value.length) > 50000 ? 400 : 80); };
  root.addEventListener('input', schedule); root.addEventListener('change', schedule);
  root.querySelector('[data-swap]')!.addEventListener('click', () => { [a.value, b.value] = [b.value, a.value]; run(); });
</script>
