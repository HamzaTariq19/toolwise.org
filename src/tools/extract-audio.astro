---
import Icon from '../components/Icon.astro';
import Dropzone from '../components/Dropzone.astro';
import TaskProgress from '../components/TaskProgress.astro';
import FfmpegNote from '../components/FfmpegNote.astro';
---
<div id="xa" class="space-y-4">
  <p class="alert alert-error" data-unsupported hidden role="alert"><Icon name="CircleAlert" size={18} class="mt-0.5 flex-none" /><span>This browser can't run the audio and video tools. Please use the latest Chrome, Edge, Firefox or Safari.</span></p>
  <Dropzone id="xa-drop" accept="video/*,.mkv,.mov,.m4v,.avi,.wmv,.flv,.3gp,.ts,.mts" formats="MP4, MOV, WebM, MKV, AVI and more" maxLabel="2 GB" icon="FileVideo" label="Choose video" />
  <p class="alert alert-error" data-error hidden role="alert"><Icon name="CircleAlert" size={18} class="mt-0.5 flex-none" /><span data-msg></span></p>
  <section class="card space-y-4 p-4 sm:p-5" data-opts hidden>
    <div class="flex items-start gap-3"><span class="icon-tile h-11 w-11"><Icon name="FileVideo" size={22} /></span><div class="min-w-0 flex-1"><p class="truncate font-semibold" data-name></p><p class="text-sm text-muted" data-meta></p></div><button type="button" class="btn btn-ghost btn-sm" data-change>Change</button></div>
    <div><p class="label">Audio format</p>
      <div class="segmented" role="radiogroup" aria-label="Audio format">
        <label><input type="radio" name="xa-fmt" value="copy" checked /><span data-copylbl>Original</span></label>
        <label><input type="radio" name="xa-fmt" value="mp3" /><span>MP3</span></label>
        <label><input type="radio" name="xa-fmt" value="wav" /><span>WAV</span></label>
      </div>
      <p class="hint" data-fmthint></p>
    </div>
    <div data-brbox hidden><label for="xa-br" class="label">MP3 quality</label><select id="xa-br" class="select w-auto"><option value="128">128 kbps (smaller)</option><option value="192" selected>192 kbps (recommended)</option><option value="320">320 kbps (best)</option></select></div>
    <button type="button" class="btn btn-primary btn-lg w-full sm:w-auto" data-go><Icon name="FileAudio" size={18} />Extract audio</button>
  </section>
  <TaskProgress id="xa-task" />
  <section class="card space-y-4 p-4 sm:p-5" data-result hidden aria-live="polite">
    <div class="flex items-center gap-2 text-success"><Icon name="CircleCheck" size={22} /><p class="font-semibold text-[var(--text)]" data-rsum></p></div>
    <audio controls class="w-full" data-player></audio>
    <div class="flex flex-col gap-3 sm:flex-row"><button type="button" class="btn btn-primary btn-lg" data-dl><Icon name="Download" size={18} /><span data-label>Download</span></button><button type="button" class="btn btn-secondary btn-lg" data-again><Icon name="RotateCcw" size={18} />Another video</button></div>
  </section>
  <FfmpegNote />
</div>
<script>
  import { initDropzone } from '../lib/dropzone';
  import { taskProgress } from '../lib/task-progress';
  import { showError, formatBytes, baseName, downloadBlob } from '../lib/ui';
  import { ffmpegSupported, loadFFmpeg, probe, run, cancelFFmpeg, toBlob, hms, type Probe } from '../lib/ffmpeg';
  const root = document.getElementById('xa')!, q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const drop = q('#xa-drop'), opts = q('[data-opts]'), result = q('[data-result]'), err = q('[data-error]');
  // Codecs that can be saved as they are, with a fitting file type
  const COPY: Record<string, [string, string, string]> = { aac: ['m4a', 'audio/mp4', 'M4A (AAC)'], alac: ['m4a', 'audio/mp4', 'M4A (ALAC)'], mp3: ['mp3', 'audio/mpeg', 'MP3'], opus: ['opus', 'audio/ogg', 'Opus'], vorbis: ['ogg', 'audio/ogg', 'OGG'], flac: ['flac', 'audio/flac', 'FLAC'], ac3: ['ac3', 'audio/ac3', 'AC3'], eac3: ['eac3', 'audio/eac3', 'E-AC3'] };
  let file: File | null = null, info: Probe | null = null, out: { blob: Blob; name: string } | null = null, cancelled = false, url = '';
  const task = taskProgress(q('#xa-task'), () => { cancelled = true; cancelFFmpeg(); task.hide(); opts.hidden = !file; showError(err, 'Cancelled.'); });
  if (!ffmpegSupported()) { q('[data-unsupported]').hidden = false; drop.hidden = true; }
  const fmt = () => (q<HTMLInputElement>('input[name=xa-fmt]:checked')).value;
  function fmtHint() {
    const c = info?.audio?.codec ?? '', copy = COPY[c] || (c.startsWith('pcm_') ? ['wav', 'audio/wav', 'WAV'] : null);
    q('[data-brbox]').hidden = fmt() !== 'mp3';
    q('[data-fmthint]').textContent = fmt() === 'copy' ? (copy ? `Saves the soundtrack exactly as it is in the video (${copy[2]}), with no quality loss. Fastest.` : 'This soundtrack type has no common audio file format, so it will be converted to MP3.') : fmt() === 'mp3' ? 'Plays everywhere. Converting takes a little longer.' : 'Uncompressed and large. Good for editing.';
  }
  root.querySelectorAll('input[name=xa-fmt]').forEach((r) => r.addEventListener('change', fmtHint));
  async function pick(f: File) {
    file = f; out = null; cancelled = false; result.hidden = true; drop.hidden = true; showError(err, null);
    task.show('Getting the video tools ready…');
    try {
      await loadFFmpeg(task.download('video tools'));
      task.set('Reading the video…', null, '');
      info = await probe(f);
      if (!info.audio) throw new Error('This video has no sound track, so there is no audio to extract.');
      task.hide(); opts.hidden = false;
      q('[data-name]').textContent = f.name;
      q('[data-meta]').textContent = `${formatBytes(f.size)} · ${hms(info.duration)} · sound: ${info.audio.codec.toUpperCase()}, ${info.audio.rate / 1000} kHz, ${info.audio.channels}`;
      const c = info.audio.codec, copy = COPY[c] || (c.startsWith('pcm_') ? ['wav', '', 'WAV'] : null);
      q('[data-copylbl]').textContent = copy ? `Original (${copy[0].toUpperCase()})` : 'Original';
      fmtHint();
    } catch (e) { if (cancelled) return; task.hide(); drop.hidden = false; opts.hidden = true; file = null; showError(err, (e as Error).message || 'Something went wrong.'); }
  }
  q('[data-go]').addEventListener('click', async () => {
    if (!file || !info) return;
    cancelled = false; opts.hidden = true; showError(err, null);
    const c = info.audio!.codec, mode = fmt(); let copy = COPY[c] || (c.startsWith('pcm_') ? ['wav', 'audio/wav', 'WAV'] as [string, string, string] : null);
    let args: string[], ext: string, type: string;
    if (mode === 'copy' && copy) { [ext, type] = copy; args = ['-i', '{in}', '-vn', '-map', '0:a:0', '-c:a', 'copy', `out.${ext}`]; }
    else if (mode === 'wav') { ext = 'wav'; type = 'audio/wav'; args = ['-i', '{in}', '-vn', '-map', '0:a:0', '-c:a', 'pcm_s16le', 'out.wav']; }
    else { ext = 'mp3'; type = 'audio/mpeg'; args = ['-i', '{in}', '-vn', '-map', '0:a:0', '-c:a', 'libmp3lame', '-b:a', `${mode === 'mp3' ? q<HTMLSelectElement>('#xa-br').value : 192}k`, 'out.mp3']; }
    task.show('Extracting audio…');
    try {
      const data = await run(file, args, `out.${ext}`, info.duration, (p) => task.set('Extracting audio…', p));
      out = { blob: toBlob(data, type), name: `${baseName(file.name)}.${ext}` };
      task.hide(); result.hidden = false;
      q('[data-rsum]').textContent = `${out.name} · ${formatBytes(out.blob.size)}`;
      URL.revokeObjectURL(url); url = URL.createObjectURL(out.blob); q<HTMLAudioElement>('[data-player]').src = url;
      q<HTMLButtonElement>('[data-dl]').focus();
    } catch (e) { if (cancelled) return; task.hide(); opts.hidden = false; showError(err, (e as Error).message); }
  });
  q('[data-dl]').addEventListener('click', () => out && downloadBlob(out.blob, out.name));
  const reset = () => { file = null; info = null; out = null; result.hidden = true; opts.hidden = true; drop.hidden = false; showError(err, null); q<HTMLAudioElement>('[data-player]').removeAttribute('src'); };
  q('[data-again]').addEventListener('click', reset); q('[data-change]').addEventListener('click', reset);
  initDropzone(drop, { accept: ['video/*', '.mkv', '.mov', '.m4v', '.avi', '.wmv', '.flv', '.3gp', '.ts', '.mts', '.webm'], maxBytes: 2 * 1024 ** 3, onFiles: (f) => pick(f[0]), onError: (m) => showError(err, m || null) });
</script>
