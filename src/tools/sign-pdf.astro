---
import Dropzone from '../components/Dropzone.astro';
import Icon from '../components/Icon.astro';
import '@fontsource/great-vibes/latin-400.css';
import '@fontsource/dancing-script/latin-600.css';
import '@fontsource/caveat/latin-600.css';
---
<div id="sg" class="space-y-5">
  <div data-step="pick">
    <Dropzone id="sg-drop" accept="application/pdf,.pdf" formats="PDF file" maxLabel="100 MB" label="Choose PDF file" icon="Signature" />
  </div>
  <div class="alert alert-error" data-error hidden role="alert"><span data-msg></span></div>

  <!-- Step 2: create signature -->
  <section data-step="create" class="card p-5 sm:p-6" hidden aria-labelledby="sg-create-h">
    <h2 id="sg-create-h" class="text-lg font-bold">Create your signature</h2>
    <div class="segmented mt-4" role="tablist">
      <label><input type="radio" name="sg-mode" value="draw" checked /><span>Draw</span></label>
      <label><input type="radio" name="sg-mode" value="type" /><span>Type</span></label>
      <label><input type="radio" name="sg-mode" value="upload" /><span>Upload image</span></label>
    </div>

    <div class="mt-4" data-mode="draw">
      <div class="relative rounded-xl border border-line-strong bg-white">
        <canvas data-pad class="block h-48 w-full touch-none rounded-xl sm:h-56" aria-label="Signature drawing area. Draw with your finger, pen or mouse."></canvas>
        <div class="pointer-events-none absolute inset-x-6 bottom-10 border-b border-dashed border-gray-300"></div>
        <p class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 text-center text-gray-400" data-pad-hint>Sign here with your finger or mouse</p>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <span class="text-sm font-medium text-muted">Ink</span>
        {[['#111827', 'Black'], ['#1d3a8a', 'Blue']].map(([c, n], i) => (
          <label class="relative">
            <input type="radio" name="sg-ink" value={c} checked={i === 0} class="peer absolute opacity-0" />
            <span class="block h-9 w-9 cursor-pointer rounded-full border-2 border-transparent ring-2 ring-transparent peer-checked:ring-[var(--ring)] peer-focus-visible:outline peer-focus-visible:outline-2" style={`background:${c}`} title={n}></span>
            <span class="sr-only">{n}</span>
          </label>
        ))}
        <button type="button" class="btn btn-ghost btn-sm ml-auto" data-clear-pad><Icon name="Eraser" size={16} />Clear</button>
      </div>
    </div>

    <div class="mt-4 space-y-3" data-mode="type" hidden>
      <label for="sg-name" class="label">Your name</label>
      <input id="sg-name" class="input sm:max-w-md" placeholder="Type your full name" autocomplete="name" />
      <div class="grid gap-2 sm:grid-cols-3" data-fonts>
        {[["'Great Vibes'", 'Great Vibes'], ["'Dancing Script'", 'Dancing Script'], ["'Caveat'", 'Caveat']].map(([f, n], i) => (
          <label class="flex min-h-16 cursor-pointer items-center justify-center rounded-[10px] border border-line-strong bg-white px-3 text-gray-900 has-[:checked]:border-[var(--ring)] has-[:checked]:ring-2 has-[:checked]:ring-[var(--ring)]/30">
            <input type="radio" name="sg-font" value={f} checked={i === 0} class="sr-only" />
            <span class="truncate text-3xl" style={`font-family:${f}`} data-font-preview>Your name</span>
            <span class="sr-only">{n}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="mt-4" data-mode="upload" hidden>
      <label class="btn btn-secondary relative cursor-pointer">
        <Icon name="Upload" size={18} /> Choose signature image
        <input type="file" accept="image/png,image/jpeg,image/webp" class="absolute inset-0 cursor-pointer opacity-0" data-sig-file />
      </label>
      <p class="hint">A photo of your signature on white paper works well. The white background is removed automatically.</p>
      <img data-upload-preview alt="Uploaded signature preview" class="mt-3 max-h-32 rounded-lg border border-line bg-white p-2" hidden />
    </div>

    <p class="alert alert-error mt-4" data-sig-error hidden role="alert"><span data-msg></span></p>
    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-primary btn-lg" data-use><Icon name="Check" size={20} />Use this signature</button>
      <button type="button" class="btn btn-secondary btn-lg" data-cancel>Choose another PDF</button>
    </div>
  </section>

  <!-- Step 3: place -->
  <section data-step="place" hidden aria-label="Place your signature">
    <div class="card sticky top-[4.5rem] z-20 flex flex-wrap items-center gap-x-3 gap-y-2 p-3 shadow-sm">
      <img data-sig-preview alt="Your signature" class="h-11 w-28 flex-none rounded-md border border-line bg-white object-contain px-1" />
      <button type="button" class="btn btn-secondary btn-sm ml-auto flex-none" data-change>Change signature</button>
      <p class="w-full text-[0.9375rem] font-medium leading-snug sm:order-first sm:w-auto sm:flex-1" data-place-hint>Tap the page where you want to sign.</p>
    </div>
    <div class="mt-4 space-y-5" data-pages></div>
    <div class="sticky bottom-3 z-20 mt-5">
      <button type="button" class="btn btn-primary btn-lg w-full shadow-lg sm:w-auto" data-save disabled><Icon name="Download" size={20} /><span data-label>Download signed PDF</span></button>
    </div>
    <button type="button" class="btn btn-secondary btn-lg mt-3 w-full sm:w-auto" data-reset><Icon name="RotateCcw" size={18} />Start over</button>
  </section>
</div>

<style is:global>
  .sig-box { position: absolute; touch-action: none; cursor: move; outline: 1.5px dashed #2563eb; outline-offset: 2px; }
  .sig-box img { width: 100%; height: 100%; pointer-events: none; user-select: none; }
  .sig-box button { position: absolute; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 999px; background: #2563eb; color: #fff; }
  .sig-box [data-del] { top: -16px; right: -16px; background: #dc2626; }
  .sig-box [data-resize] { bottom: -16px; right: -16px; cursor: nwse-resize; touch-action: none; }
</style>

<script>
  import { initDropzone } from '../lib/dropzone';
  import { openPdf, getPdfLib, pdfBlob, renderPage, PdfPasswordError } from '../lib/pdf';
  import { downloadBlob, baseName, showError, setBusy } from '../lib/ui';
  import type { PDFDocumentProxy, PDFPageProxy } from 'pdfjs-dist/types/src/display/api';
  type PageViewport = ReturnType<PDFPageProxy['getViewport']>;

  const root = document.getElementById('sg')!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const steps = { pick: $('[data-step=pick]'), create: $('[data-step=create]'), place: $('[data-step=place]') };
  const show = (k: keyof typeof steps) => Object.entries(steps).forEach(([n, el]) => (el.hidden = n !== k));
  const err = $('[data-error]');
  const sigErr = $('[data-sig-error]');
  const pad = $<HTMLCanvasElement>('[data-pad]');
  const pagesEl = $('[data-pages]');
  const saveBtn = $<HTMLButtonElement>('[data-save]');

  let file: File | null = null;
  let bytes: ArrayBuffer | null = null;
  let doc: PDFDocumentProxy | null = null;
  let sigUrl = '';
  let sigRatio = 3; // width / height
  let uploaded: HTMLCanvasElement | null = null;
  // placements in viewport-normalized coords (0..1, top-left origin)
  type Placement = { page: number; x: number; y: number; w: number; el: HTMLElement };
  let placements: Placement[] = [];
  const viewports: PageViewport[] = [];

  const mode = () => root.querySelector<HTMLInputElement>('input[name=sg-mode]:checked')!.value;
  root.querySelectorAll<HTMLInputElement>('input[name=sg-mode]').forEach((r) => r.addEventListener('change', () => {
    root.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== mode()));
    showError(sigErr, null);
    if (mode() === 'draw') sizePad();
  }));

  // ---------- Drawing pad ----------
  let strokes: { x: number; y: number }[][] = [];
  const ink = () => root.querySelector<HTMLInputElement>('input[name=sg-ink]:checked')!.value;
  function sizePad() {
    const r = pad.getBoundingClientRect();
    if (!r.width) return;
    const dpr = Math.min(3, devicePixelRatio || 1);
    pad.width = r.width * dpr; pad.height = r.height * dpr;
    redrawPad();
  }
  function redrawPad() {
    const ctx = pad.getContext('2d')!;
    const dpr = pad.width / pad.getBoundingClientRect().width || 1;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, pad.width, pad.height);
    ctx.strokeStyle = ink(); ctx.lineWidth = 2.6; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    for (const s of strokes) {
      ctx.beginPath();
      s.forEach((p, i) => {
        if (i === 0) ctx.moveTo(p.x, p.y);
        else { const prev = s[i - 1]; ctx.quadraticCurveTo(prev.x, prev.y, (prev.x + p.x) / 2, (prev.y + p.y) / 2); }
      });
      if (s.length === 1) ctx.lineTo(s[0].x + 0.1, s[0].y);
      ctx.stroke();
    }
    $('[data-pad-hint]').hidden = strokes.length > 0;
  }
  let drawing = false;
  pad.addEventListener('pointerdown', (e) => { drawing = true; pad.setPointerCapture(e.pointerId); const r = pad.getBoundingClientRect(); strokes.push([{ x: e.clientX - r.left, y: e.clientY - r.top }]); redrawPad(); showError(sigErr, null); });
  pad.addEventListener('pointermove', (e) => { if (!drawing) return; const r = pad.getBoundingClientRect(); strokes[strokes.length - 1].push({ x: e.clientX - r.left, y: e.clientY - r.top }); redrawPad(); });
  pad.addEventListener('pointerup', () => (drawing = false));
  pad.addEventListener('pointercancel', () => (drawing = false));
  $('[data-clear-pad]').addEventListener('click', () => { strokes = []; redrawPad(); });
  root.querySelectorAll('input[name=sg-ink]').forEach((r) => r.addEventListener('change', redrawPad));
  window.addEventListener('resize', () => { if (!steps.create.hidden && mode() === 'draw') sizePad(); });

  // ---------- Typed ----------
  const nameIn = $<HTMLInputElement>('#sg-name');
  nameIn.addEventListener('input', () => {
    root.querySelectorAll<HTMLElement>('[data-font-preview]').forEach((el) => (el.textContent = nameIn.value.trim() || 'Your name'));
    showError(sigErr, null);
  });

  // ---------- Upload ----------
  const sigFile = $<HTMLInputElement>('[data-sig-file]');
  sigFile.addEventListener('change', async () => {
    const f = sigFile.files?.[0];
    if (!f) return;
    try {
      const bmp = await createImageBitmap(f);
      const c = document.createElement('canvas');
      const s = Math.min(1, 1200 / bmp.width);
      c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
      const ctx = c.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(bmp, 0, 0, c.width, c.height);
      // Make light paper transparent
      const d = ctx.getImageData(0, 0, c.width, c.height);
      for (let i = 0; i < d.data.length; i += 4) {
        const l = 0.299 * d.data[i] + 0.587 * d.data[i + 1] + 0.114 * d.data[i + 2];
        d.data[i + 3] = l > 200 ? 0 : l > 150 ? Math.round(((200 - l) / 50) * d.data[i + 3]) : d.data[i + 3];
      }
      ctx.putImageData(d, 0, 0);
      uploaded = trim(c);
      const img = $<HTMLImageElement>('[data-upload-preview]');
      img.src = uploaded.toDataURL('image/png'); img.hidden = false;
      showError(sigErr, null);
    } catch { showError(sigErr, 'That image could not be opened. Try a PNG or JPG file.'); }
  });

  /** Crop transparent edges */
  function trim(c: HTMLCanvasElement): HTMLCanvasElement {
    const ctx = c.getContext('2d', { willReadFrequently: true })!;
    const { data, width, height } = ctx.getImageData(0, 0, c.width, c.height);
    let x0 = width, y0 = height, x1 = -1, y1 = -1;
    for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) if (data[(y * width + x) * 4 + 3] > 10) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }
    if (x1 < 0) return c;
    const pad = 6;
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad); x1 = Math.min(width - 1, x1 + pad); y1 = Math.min(height - 1, y1 + pad);
    const out = document.createElement('canvas');
    out.width = x1 - x0 + 1; out.height = y1 - y0 + 1;
    out.getContext('2d')!.drawImage(c, x0, y0, out.width, out.height, 0, 0, out.width, out.height);
    return out;
  }

  async function buildSignature(): Promise<HTMLCanvasElement | null> {
    if (mode() === 'draw') {
      if (!strokes.length) { showError(sigErr, 'Please draw your signature in the box first.'); return null; }
      const r = pad.getBoundingClientRect();
      const scale = 3;
      const c = document.createElement('canvas');
      c.width = r.width * scale; c.height = r.height * scale;
      const ctx = c.getContext('2d')!;
      ctx.scale(scale, scale);
      ctx.strokeStyle = ink(); ctx.lineWidth = 2.6; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      for (const s of strokes) { ctx.beginPath(); s.forEach((p, i) => { if (!i) ctx.moveTo(p.x, p.y); else { const q = s[i - 1]; ctx.quadraticCurveTo(q.x, q.y, (q.x + p.x) / 2, (q.y + p.y) / 2); } }); if (s.length === 1) ctx.lineTo(s[0].x + 0.1, s[0].y); ctx.stroke(); }
      return trim(c);
    }
    if (mode() === 'type') {
      const text = nameIn.value.trim();
      if (!text) { showError(sigErr, 'Please type your name first.'); nameIn.focus(); return null; }
      const font = root.querySelector<HTMLInputElement>('input[name=sg-font]:checked')!.value;
      const weight = font.includes('Great') ? 400 : 600;
      await document.fonts.load(`${weight} 120px ${font}`);
      const c = document.createElement('canvas');
      const ctx = c.getContext('2d')!;
      ctx.font = `${weight} 120px ${font}`;
      c.width = Math.ceil(ctx.measureText(text).width + 80); c.height = 220;
      ctx.font = `${weight} 120px ${font}`;
      ctx.fillStyle = '#111827'; ctx.textBaseline = 'middle';
      ctx.fillText(text, 40, 115);
      return trim(c);
    }
    if (!uploaded) { showError(sigErr, 'Please choose an image of your signature.'); return null; }
    return uploaded;
  }

  $('[data-use]').addEventListener('click', async () => {
    const c = await buildSignature();
    if (!c) return;
    sigRatio = c.width / c.height;
    sigUrl = c.toDataURL('image/png');
    $<HTMLImageElement>('[data-sig-preview]').src = sigUrl;
    placements.forEach((p) => (p.el.querySelector('img')!.src = sigUrl));
    placements.forEach((p) => layoutBox(p));
    show('place');
    if (!pagesEl.childElementCount) await renderPages();
  });
  $('[data-change]').addEventListener('click', () => { show('create'); requestAnimationFrame(sizePad); });
  $('[data-cancel]').addEventListener('click', () => reset());

  // ---------- Pages ----------
  async function renderPages() {
    if (!doc) return;
    const width = Math.min(pagesEl.getBoundingClientRect().width || 800, 820);
    for (let i = 1; i <= doc.numPages; i++) {
      const page = await doc.getPage(i);
      const vp = page.getViewport({ scale: 1 });
      viewports[i - 1] = vp;
      const wrap = document.createElement('div');
      wrap.className = 'relative mx-auto overflow-visible rounded-md border border-line bg-white shadow-sm';
      wrap.style.maxWidth = `${width}px`;
      wrap.style.aspectRatio = `${vp.width} / ${vp.height}`;
      wrap.dataset.page = String(i - 1);
      wrap.setAttribute('role', 'button');
      wrap.setAttribute('aria-label', `Page ${i} of ${doc.numPages}. Tap to place your signature.`);
      wrap.tabIndex = 0;
      const label = document.createElement('span');
      label.className = 'absolute -top-3 left-3 rounded-full bg-surface px-2 text-xs font-semibold text-subtle border border-line';
      label.textContent = `Page ${i}`;
      wrap.appendChild(label);
      pagesEl.appendChild(wrap);
      lazyRender(wrap, i);
    }
  }
  const io = new IntersectionObserver((entries) => entries.forEach(async (e) => {
    if (!e.isIntersecting) return;
    const el = e.target as HTMLElement;
    io.unobserve(el);
    const page = await doc!.getPage(Number(el.dataset.page) + 1);
    const w = el.getBoundingClientRect().width;
    const canvas = await renderPage(page, (w * Math.min(2, devicePixelRatio || 1)) / page.getViewport({ scale: 1 }).width);
    canvas.className = 'block h-full w-full rounded-md';
    canvas.setAttribute('aria-hidden', 'true');
    el.prepend(canvas);
  }), { rootMargin: '600px' });
  function lazyRender(el: HTMLElement, _i: number) { io.observe(el); }

  pagesEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('.sig-box')) return;
    const wrap = t.closest<HTMLElement>('[data-page]');
    if (!wrap || !sigUrl) return;
    const r = wrap.getBoundingClientRect();
    const w = 0.3;
    const h = (w * r.width) / sigRatio / r.height;
    addPlacement(Number(wrap.dataset.page), (e.clientX - r.left) / r.width - w / 2, (e.clientY - r.top) / r.height - h / 2, w);
  });
  pagesEl.addEventListener('keydown', (e) => {
    const wrap = (e.target as HTMLElement).closest<HTMLElement>('[data-page]');
    if (!wrap || (e.key !== 'Enter' && e.key !== ' ') || (e.target as HTMLElement).closest('.sig-box')) return;
    e.preventDefault();
    addPlacement(Number(wrap.dataset.page), 0.55, 0.8, 0.3);
  });

  function addPlacement(page: number, x: number, y: number, w: number) {
    const el = document.createElement('div');
    el.className = 'sig-box';
    el.tabIndex = 0;
    el.setAttribute('aria-label', 'Signature. Drag to move, use the corner handle to resize. Press Delete to remove.');
    el.innerHTML = `<img src="${sigUrl}" alt="" /><button type="button" data-del aria-label="Remove signature"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button><button type="button" data-resize aria-label="Resize signature"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg></button>`;
    const p: Placement = { page, x, y, w, el };
    placements.push(p);
    pagesEl.querySelector(`[data-page="${page}"]`)!.appendChild(el);
    layoutBox(p);
    wireBox(p);
    updateSave();
  }

  function pageRect(p: Placement) { return (p.el.parentElement as HTMLElement).getBoundingClientRect(); }
  function clampP(p: Placement) {
    const r = pageRect(p);
    const h = (p.w * r.width) / sigRatio / r.height;
    p.w = Math.min(Math.max(p.w, 0.05), 1);
    p.x = Math.min(Math.max(p.x, 0), 1 - p.w);
    p.y = Math.min(Math.max(p.y, 0), Math.max(0, 1 - h));
  }
  function layoutBox(p: Placement) {
    clampP(p);
    const r = pageRect(p);
    p.el.style.left = `${p.x * 100}%`;
    p.el.style.top = `${p.y * 100}%`;
    p.el.style.width = `${p.w * 100}%`;
    p.el.style.height = `${((p.w * r.width) / sigRatio / r.height) * 100}%`;
  }
  function wireBox(p: Placement) {
    let start: { x: number; y: number; px: number; py: number; w: number; resize: boolean } | null = null;
    p.el.addEventListener('pointerdown', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-del]')) return;
      e.preventDefault();
      p.el.setPointerCapture(e.pointerId);
      start = { x: e.clientX, y: e.clientY, px: p.x, py: p.y, w: p.w, resize: !!t.closest('[data-resize]') };
    });
    p.el.addEventListener('pointermove', (e) => {
      if (!start) return;
      const r = pageRect(p);
      const dx = (e.clientX - start.x) / r.width, dy = (e.clientY - start.y) / r.height;
      if (start.resize) p.w = start.w + dx; else { p.x = start.px + dx; p.y = start.py + dy; }
      layoutBox(p);
    });
    p.el.addEventListener('pointerup', () => (start = null));
    p.el.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-del]')) remove(p); e.stopPropagation(); });
    p.el.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 0.05 : 0.01;
      if (e.key === 'Delete' || e.key === 'Backspace') { remove(p); return; }
      else if (e.key === 'ArrowLeft') p.x -= step; else if (e.key === 'ArrowRight') p.x += step;
      else if (e.key === 'ArrowUp') p.y -= step; else if (e.key === 'ArrowDown') p.y += step;
      else if (e.key === '+' || e.key === '=') p.w += 0.02; else if (e.key === '-') p.w -= 0.02;
      else return;
      e.preventDefault(); layoutBox(p);
    });
  }
  function remove(p: Placement) { p.el.remove(); placements = placements.filter((x) => x !== p); updateSave(); }
  function updateSave() {
    saveBtn.disabled = !placements.length;
    $('[data-place-hint]').textContent = placements.length
      ? `${placements.length} signature${placements.length > 1 ? 's' : ''} placed. Drag to move, use the corner to resize.`
      : 'Tap the page where you want to sign.';
  }
  window.addEventListener('resize', () => placements.forEach(layoutBox));

  saveBtn.addEventListener('click', async () => {
    if (!bytes || !file || !placements.length) return;
    setBusy(saveBtn, true, 'Saving…');
    try {
      const { PDFDocument, degrees } = await getPdfLib();
      const pdf = await PDFDocument.load(bytes, { updateMetadata: false });
      const png = await pdf.embedPng(sigUrl);
      for (const p of placements) {
        const vp = viewports[p.page];
        const page = pdf.getPage(p.page);
        const r = pageRect(p);
        const hFrac = (p.w * r.width) / sigRatio / r.height;
        // Convert the box's on-screen bottom-left corner to PDF coordinates (handles rotated pages)
        const [x, y] = vp.convertToPdfPoint(p.x * vp.width, (p.y + hFrac) * vp.height);
        const w = p.w * vp.width, h = hFrac * vp.height;
        page.drawImage(png, { x, y, width: w, height: h, rotate: degrees(vp.rotation) });
      }
      const out = await pdf.save();
      downloadBlob(pdfBlob(out), `${baseName(file.name)}-signed.pdf`);
    } catch (e) {
      showError(err, `Saving failed: ${(e as Error).message}`);
    } finally { setBusy(saveBtn, false); }
  });

  function reset() {
    placements = []; viewports.length = 0; pagesEl.innerHTML = ''; doc?.loadingTask.destroy(); doc = null; bytes = null; file = null; sigUrl = '';
    updateSave(); show('pick');
  }
  $('[data-reset]').addEventListener('click', reset);

  initDropzone(document.getElementById('sg-drop')!, {
    accept: ['application/pdf', '.pdf'], maxBytes: 100 * 1024 * 1024,
    onFiles: async ([f]) => {
      try {
        showError(err, null);
        const buf = await f.arrayBuffer();
        doc = await openPdf(buf);
        const { PDFDocument } = await getPdfLib();
        const test = await PDFDocument.load(buf, { ignoreEncryption: true, updateMetadata: false }).catch(() => null);
        if (!test) throw new Error('This file could not be read as a PDF. It may be damaged.');
        if (test.isEncrypted) throw new PdfPasswordError('This PDF has security restrictions. Unlock it first, then try again.');
        bytes = buf; file = f;
        show('create');
        requestAnimationFrame(sizePad);
      } catch (e) { showError(err, (e as Error).message); }
    },
    onError: (m) => showError(err, m || null),
  });
</script>
