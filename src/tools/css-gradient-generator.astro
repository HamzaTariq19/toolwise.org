---
import Icon from '../components/Icon.astro';
import { PRESETS, gradientCss, codeText, stopsHtml, presetsHtml } from '../lib/gradient';
const s0 = PRESETS[0][1], c0 = gradientCss(s0, 'linear', PRESETS[0][2]);
---
<div id="gg" class="grid gap-5 md:grid-cols-[1fr_320px] md:items-start">
  <div class="space-y-4">
    <div class="h-56 rounded-2xl border border-line sm:h-72" data-preview style={`background:${c0}`} role="img" aria-label="Gradient preview"></div>
    <section class="card p-4">
      <div class="flex items-center justify-between"><h2 class="text-base font-semibold">CSS code</h2><button type="button" class="btn btn-primary btn-sm" data-copy><Icon name="Copy" size={16} /><span data-label>Copy CSS</span></button></div>
      <pre class="mono mt-3 overflow-x-auto whitespace-pre-wrap break-all rounded-lg bg-surface-2 p-3 text-sm" data-code>{codeText(s0, c0)}</pre>
    </section>
    <div class="flex flex-wrap gap-2" data-presets aria-label="Presets" set:html={presetsHtml()}></div>
  </div>
  <div class="card space-y-5 p-5 md:sticky md:top-24">
    <fieldset><legend class="label">Type</legend><div class="segmented"><label><input type="radio" name="gg-t" value="linear" checked /><span>Linear</span></label><label><input type="radio" name="gg-t" value="radial" /><span>Radial</span></label><label><input type="radio" name="gg-t" value="conic" /><span>Conic</span></label></div></fieldset>
    <div data-angle><div class="flex justify-between"><label for="gg-a" class="label">Angle</label><output class="text-sm font-semibold tabular" data-aout>135°</output></div><input id="gg-a" type="range" min="0" max="360" value="135" class="h-11 w-full accent-[var(--brand)]" /></div>
    <div><p class="label">Colors</p><ul class="space-y-2" data-stops set:html={stopsHtml(s0)}></ul><button type="button" class="btn btn-secondary btn-sm mt-2" data-add><Icon name="Plus" size={16} />Add color</button></div>
  </div>
</div>
<script>
  import { copyText } from '../lib/ui';
  import { PRESETS, gradientCss, codeText, stopsHtml, type Stop } from '../lib/gradient';
  const root = document.getElementById('gg')!, q = (s: string) => root.querySelector<HTMLElement>(s)!;
  let stops: Stop[] = PRESETS[0][1].map((s) => ({ ...s }));
  const type = () => (root.querySelector('input[name=gg-t]:checked') as HTMLInputElement).value;
  const angle = document.getElementById('gg-a') as HTMLInputElement;
  const css = () => gradientCss(stops, type(), angle.value);
  function renderStops() {
    q('[data-stops]').innerHTML = stopsHtml(stops);
    update();
  }
  function update() {
    const c = css();
    q('[data-preview]').style.background = c;
    q('[data-angle]').hidden = type() === 'radial'; q('[data-aout]').textContent = `${angle.value}°`;
    q('[data-code]').textContent = codeText(stops, c);
  }
  q('[data-stops]').addEventListener('input', (e) => { const t = e.target as HTMLInputElement, i = Number(t.closest<HTMLElement>('li')!.dataset.i); if (t.dataset.f === 'c') stops[i].c = t.value; else stops[i].p = Number(t.value); update(); });
  q('[data-stops]').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-del]'); if (b && stops.length > 2) { stops.splice(Number(b.closest<HTMLElement>('li')!.dataset.i), 1); renderStops(); } });
  q('[data-add]').addEventListener('click', () => { if (stops.length >= 8) return; stops.push({ c: '#ffffff', p: 50 }); renderStops(); });
  root.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('input[name=gg-t]')) update(); });
  angle.addEventListener('input', update);
  q('[data-copy]').addEventListener('click', (e) => copyText(q('[data-code]').textContent ?? '', e.currentTarget as HTMLElement));
    q('[data-presets]').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-p]'); if (!b) return; const [, s, a] = PRESETS[Number(b.dataset.p)]; stops = s.map((x) => ({ ...x })); angle.value = String(a); renderStops(); });
  renderStops();
</script>
