---
import PdfOptionsTool from '../components/PdfOptionsTool.astro';
import Icon from '../components/Icon.astro';
---
<PdfOptionsTool id="cr" icon="Crop" action="Crop PDF">
  <div class="grid gap-5 md:grid-cols-[minmax(0,320px)_1fr] md:items-start">
    <div>
      <div class="relative mx-auto w-full max-w-[320px] touch-none select-none overflow-hidden rounded-md border border-line bg-white" data-stage>
        <canvas data-canvas class="block h-auto w-full" aria-hidden="true"></canvas>
        <div class="absolute cursor-move outline outline-2 outline-[#2563eb] [box-shadow:0_0_0_9999px_rgb(15_23_42/0.45)]" data-box>
          {['nw', 'ne', 'sw', 'se'].map((h) => <span class={`absolute h-6 w-6 rounded-full border-2 border-white bg-[#2563eb] ${h.includes('n') ? '-top-3' : '-bottom-3'} ${h.includes('w') ? '-left-3' : '-right-3'} ${h === 'nw' || h === 'se' ? 'cursor-nwse-resize' : 'cursor-nesw-resize'}`} data-h={h}></span>)}
        </div>
      </div>
      <div class="mt-2 flex items-center justify-center gap-2" data-pager>
        <button type="button" class="btn btn-ghost h-10 w-10 !p-0" data-prev aria-label="Previous page"><Icon name="ChevronLeft" size={18} /></button>
        <span class="text-sm text-muted tabular" data-pageno>Page 1</span>
        <button type="button" class="btn btn-ghost h-10 w-10 !p-0" data-next aria-label="Next page"><Icon name="ChevronRight" size={18} /></button>
      </div>
    </div>
    <div class="space-y-4">
      <p class="text-[0.9375rem] text-muted">Drag the blue corners on the preview, or type the margins to cut off.</p>
      <fieldset><legend class="label">Margins to remove (mm)</legend>
        <div class="grid grid-cols-2 gap-3">
          {[['t', 'Top'], ['b', 'Bottom'], ['l', 'Left'], ['r', 'Right']].map(([k, l]) => (
            <div><label for={`cr-${k}`} class="text-sm text-muted">{l}</label><input id={`cr-${k}`} class="input tabular" inputmode="decimal" value="0" data-m={k} /></div>
          ))}
        </div>
      </fieldset>
      <fieldset><legend class="label">Apply to</legend>
        <div class="segmented"><label><input type="radio" name="cr-scope" value="all" checked /><span>All pages</span></label><label><input type="radio" name="cr-scope" value="one" /><span>Only this page</span></label></div>
      </fieldset>
      <button type="button" class="btn btn-ghost btn-sm" data-reset-crop>Reset crop</button>
    </div>
  </div>
</PdfOptionsTool>
<script>
  import { initOptionsTool } from '../lib/pdf-options-tool';
  import { loadPdfLibDoc, openPdf, renderPage, visualBox } from '../lib/pdf';
  import { num } from '../lib/ui';
  import type { PDFDocumentProxy } from 'pdfjs-dist/types/src/display/api';
  const root = document.getElementById('cr')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const stage = q('[data-stage]'), box = q('[data-box]'), canvas = q<HTMLCanvasElement>('[data-canvas]');
  const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-m]'));
  const MM = 25.4 / 72;
  let view: PDFDocumentProxy | null = null, pageNo = 1, size = { w: 595, h: 842 };
  // crop margins as fractions of the visible page
  let m = { t: 0, b: 0, l: 0, r: 0 };

  function layout() {
    box.style.left = `${m.l * 100}%`; box.style.top = `${m.t * 100}%`;
    box.style.width = `${(1 - m.l - m.r) * 100}%`; box.style.height = `${(1 - m.t - m.b) * 100}%`;
  }
  const syncInputs = () => inputs.forEach((i) => { const k = i.dataset.m as keyof typeof m; i.value = String(Math.round(m[k] * (k === 't' || k === 'b' ? size.h : size.w) * MM)); });
  async function show(n: number) {
    if (!view) return;
    pageNo = Math.min(Math.max(1, n), view.numPages);
    const page = await view.getPage(pageNo), vp = page.getViewport({ scale: 1 });
    size = { w: vp.width, h: vp.height };
    const c = await renderPage(page, (640 / vp.width));
    canvas.width = c.width; canvas.height = c.height; canvas.getContext('2d')!.drawImage(c, 0, 0);
    q('[data-pageno]').textContent = `Page ${pageNo} of ${view.numPages}`;
    q('[data-pager]').hidden = view.numPages < 2;
    syncInputs(); layout();
  }
  inputs.forEach((i) => i.addEventListener('input', () => {
    const k = i.dataset.m as keyof typeof m, v = num(i.value);
    if (!(v >= 0)) return;
    const frac = v / MM / (k === 't' || k === 'b' ? size.h : size.w);
    const other = k === 't' ? m.b : k === 'b' ? m.t : k === 'l' ? m.r : m.l;
    m[k] = Math.min(frac, 0.95 - other); layout();
  }));
  // Drag corners or the whole box
  let drag: { h: string; x: number; y: number; start: typeof m } | null = null;
  stage.addEventListener('pointerdown', (e) => {
    const h = (e.target as HTMLElement).dataset.h ?? ((e.target as HTMLElement).closest('[data-box]') ? 'move' : null);
    if (!h) return;
    e.preventDefault(); stage.setPointerCapture(e.pointerId);
    drag = { h, x: e.clientX, y: e.clientY, start: { ...m } };
  });
  stage.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const r = stage.getBoundingClientRect(), dx = (e.clientX - drag.x) / r.width, dy = (e.clientY - drag.y) / r.height, s = drag.start;
    const min = 0.05, c = (v: number, max: number) => Math.min(Math.max(0, v), max);
    if (drag.h === 'move') {
      const w = 1 - s.l - s.r, h = 1 - s.t - s.b;
      m.l = c(s.l + dx, 1 - w); m.r = 1 - w - m.l; m.t = c(s.t + dy, 1 - h); m.b = 1 - h - m.t;
    } else {
      if (drag.h.includes('w')) m.l = c(s.l + dx, 1 - s.r - min);
      if (drag.h.includes('e')) m.r = c(s.r - dx, 1 - s.l - min);
      if (drag.h.includes('n')) m.t = c(s.t + dy, 1 - s.b - min);
      if (drag.h.includes('s')) m.b = c(s.b - dy, 1 - s.t - min);
    }
    layout(); syncInputs();
  });
  const end = () => (drag = null);
  stage.addEventListener('pointerup', end); stage.addEventListener('pointercancel', end);
  q('[data-prev]').addEventListener('click', () => show(pageNo - 1));
  q('[data-next]').addEventListener('click', () => show(pageNo + 1));
  q('[data-reset-crop]').addEventListener('click', () => { m = { t: 0, b: 0, l: 0, r: 0 }; layout(); syncInputs(); });

  initOptionsTool('cr', {
    outSuffix: 'cropped',
    onLoaded: async ({ bytes }) => {
      view?.loadingTask.destroy();
      view = await openPdf(bytes);
      m = { t: 0.05, b: 0.05, l: 0.05, r: 0.05 };
      await show(1);
    },
    process: async ({ bytes }) => {
      if (m.t + m.b + m.l + m.r < 0.001) throw new Error('Move the blue corners or enter margins to choose what to cut off.');
      const doc = await loadPdfLibDoc(bytes);
      const all = (root.querySelector('input[name=cr-scope]:checked') as HTMLInputElement).value === 'all';
      const pages = all ? doc.getPages() : [doc.getPage(pageNo - 1)];
      for (const page of pages) {
        const { vw, vh, toPdf } = visualBox(page);
        const [x1, y1] = toPdf(m.l * vw, m.t * vh), [x2, y2] = toPdf(vw - m.r * vw, vh - m.b * vh);
        const x = Math.min(x1, x2), y = Math.min(y1, y2), w = Math.abs(x2 - x1), h = Math.abs(y2 - y1);
        page.setCropBox(x, y, w, h);
        page.setTrimBox(x, y, w, h);
      }
      return { bytes: await doc.save({ useObjectStreams: true }), note: all ? `${pages.length} pages cropped` : `Page ${pageNo} cropped` };
    },
  });
</script>
