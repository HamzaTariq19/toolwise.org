---
const inp = 'input tabular !w-24 sm:!w-28 text-center';
---
<div id="pc" class="grid gap-4">
  <section class="card p-5" data-calc="of" aria-labelledby="pc1">
    <h2 id="pc1" class="text-base font-semibold text-muted">Percent of a number</h2>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <span>What is</span>
      <input class={inp} inputmode="decimal" value="20" aria-label="Percent" data-a />
      <span>% of</span>
      <input class={inp} inputmode="decimal" value="150" aria-label="Number" data-b />
      <span>?</span>
    </div>
    <p class="mt-3 text-2xl font-bold tabular" data-out></p>
  </section>

  <section class="card p-5" data-calc="what" aria-labelledby="pc2">
    <h2 id="pc2" class="text-base font-semibold text-muted">What percent one number is of another</h2>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <input class={inp} inputmode="decimal" value="30" aria-label="Part" data-a />
      <span>is what % of</span>
      <input class={inp} inputmode="decimal" value="120" aria-label="Whole" data-b />
      <span>?</span>
    </div>
    <p class="mt-3 text-2xl font-bold tabular" data-out></p>
  </section>

  <section class="card p-5" data-calc="change" aria-labelledby="pc3">
    <h2 id="pc3" class="text-base font-semibold text-muted">Percentage increase or decrease</h2>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <span>From</span>
      <input class={inp} inputmode="decimal" value="80" aria-label="Old value" data-a />
      <span>to</span>
      <input class={inp} inputmode="decimal" value="100" aria-label="New value" data-b />
    </div>
    <p class="mt-3 text-2xl font-bold tabular" data-out></p>
  </section>

  <section class="card p-5" data-calc="addsub" aria-labelledby="pc4">
    <h2 id="pc4" class="text-base font-semibold text-muted">Add or subtract a percentage</h2>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-lg">
      <input class={inp} inputmode="decimal" value="250" aria-label="Number" data-a />
      <select class="select !w-auto" aria-label="Increase or decrease" data-op>
        <option value="1">plus</option><option value="-1">minus</option>
      </select>
      <input class={inp} inputmode="decimal" value="15" aria-label="Percent" data-b />
      <span>%</span>
    </div>
    <p class="mt-3 text-2xl font-bold tabular" data-out></p>
  </section>
</div>

<script>
  import { num, fmt } from '../lib/ui';

  const blank = 'Enter two numbers';
  const calcs: Record<string, (a: number, b: number, el: HTMLElement) => string> = {
    of: (a, b) => `${fmt(a, 6)}% of ${fmt(b, 6)} = ${fmt((a / 100) * b, 6)}`,
    what: (a, b) => (b === 0 ? 'The second number cannot be 0.' : `${fmt(a, 6)} is ${fmt((a / b) * 100, 4)}% of ${fmt(b, 6)}`),
    change: (a, b) => {
      if (a === 0) return 'The starting value cannot be 0 for a percentage change.';
      const ch = ((b - a) / Math.abs(a)) * 100;
      return ch === 0 ? 'No change (0%)' : `${ch > 0 ? 'Increase' : 'Decrease'} of ${fmt(Math.abs(ch), 4)}% (${b - a > 0 ? '+' : ''}${fmt(b - a, 6)})`;
    },
    addsub: (a, b, el) => {
      const sign = Number(el.querySelector<HTMLSelectElement>('[data-op]')!.value);
      return `= ${fmt(a * (1 + (sign * b) / 100), 6)}`;
    },
  };

  document.querySelectorAll<HTMLElement>('#pc [data-calc]').forEach((el) => {
    const a = el.querySelector<HTMLInputElement>('[data-a]')!, b = el.querySelector<HTMLInputElement>('[data-b]')!;
    const out = el.querySelector<HTMLElement>('[data-out]')!;
    const run = () => {
      const x = num(a.value), y = num(b.value);
      const bad = (Number.isNaN(x) && a.value.trim()) || (Number.isNaN(y) && b.value.trim());
      a.setAttribute('aria-invalid', String(!!(Number.isNaN(x) && a.value.trim())));
      b.setAttribute('aria-invalid', String(!!(Number.isNaN(y) && b.value.trim())));
      const msg = bad ? 'Please enter numbers only, like 25 or 12.5.' : Number.isNaN(x) || Number.isNaN(y) ? blank : calcs[el.dataset.calc!](x, y, el);
      out.textContent = msg;
      out.classList.toggle('text-subtle', msg === blank || !!bad);
      out.classList.toggle('!text-lg', msg === blank || !!bad);
    };
    el.addEventListener('input', run);
    el.addEventListener('change', run);
    run();
  });
</script>
