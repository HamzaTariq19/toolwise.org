---
import ImageEditor from '../components/ImageEditor.astro';
import '@fontsource/anton/latin-400.css';
import '@fontsource/merriweather/latin-700.css';
import '@fontsource/caveat/latin-600.css';
---
<ImageEditor id="at" icon="Type" hint="Drag on the picture to move the text.">
  <div><label for="at-text" class="label">Text</label><textarea id="at-text" class="textarea !min-h-20" maxlength="300">Your text here</textarea></div>
  <div class="grid grid-cols-2 gap-3">
    <div><label for="at-font" class="label">Font</label>
      <select id="at-font" class="select">
        <option value="700 |'Inter Variable', sans-serif">Modern</option><option value="700 |Merriweather, Georgia, serif">Classic</option>
        <option value="400 |Anton, Impact, sans-serif">Poster</option><option value="600 |Caveat, cursive">Handwritten</option>
      </select></div>
    <div><label for="at-color" class="label">Color</label><input id="at-color" type="color" value="#ffffff" class="h-11 w-full cursor-pointer rounded-[10px] border border-line-strong bg-surface p-1" /></div>
  </div>
  <div><div class="flex justify-between"><label for="at-size" class="label">Size</label><output class="text-sm font-semibold tabular" data-out>8%</output></div><input id="at-size" type="range" min="2" max="25" step="0.5" value="8" class="h-11 w-full accent-[var(--brand)]" /></div>
  <fieldset><legend class="label">Style</legend>
    <div class="segmented"><label><input type="radio" name="at-style" value="plain" /><span>Plain</span></label><label><input type="radio" name="at-style" value="outline" checked /><span>Outline</span></label><label><input type="radio" name="at-style" value="box" /><span>Box</span></label></div>
  </fieldset>
  <fieldset><legend class="label">Align</legend>
    <div class="segmented"><label><input type="radio" name="at-align" value="left" /><span>Left</span></label><label><input type="radio" name="at-align" value="center" checked /><span>Center</span></label><label><input type="radio" name="at-align" value="right" /><span>Right</span></label></div>
  </fieldset>
</ImageEditor>
<script>
  import { initImageEditor, makeCanvas } from '../lib/image-editor';
  import { drawTextBlock } from '../lib/text-draw';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const val = (n: string) => (document.querySelector(`input[name=${n}]:checked`) as HTMLInputElement).value;
  let pos = { x: 0.5, y: 0.82 };
  const ed = initImageEditor('at', {
    suffix: 'text',
    onLoad: () => { pos = { x: 0.5, y: 0.82 }; },
    validate: () => ($('at-text').value.trim() ? null : 'Type the text you want to add.'),
    render: (img, scale) => {
      const w = img.width * scale, h = img.height * scale, { c, g } = makeCanvas(w, h);
      g.drawImage(img.source, 0, 0, w, h);
      const [weight, family] = $('at-font').value.split('|'), size = (Math.min(w, h) * Number($('at-size').value)) / 100;
      const style = val('at-style'), color = $('at-color').value;
      const dark = (0.299 * parseInt(color.slice(1, 3), 16) + 0.587 * parseInt(color.slice(3, 5), 16) + 0.114 * parseInt(color.slice(5, 7), 16)) < 128;
      drawTextBlock(g, $('at-text').value, pos.x * w, pos.y * h, {
        weight: weight.trim(), font: family, size, color, align: val('at-align') as CanvasTextAlign,
        outline: style === 'outline' ? (dark ? '#ffffff' : '#000000') : undefined, outlineWidth: size * 0.14,
        box: style === 'box' ? (dark ? 'rgba(255,255,255,.82)' : 'rgba(0,0,0,.62)') : undefined,
      }, w * 0.92);
      return c;
    },
  });
  document.getElementById('at')!.addEventListener('input', () => (document.querySelector('#at [data-out]')!.textContent = `${$('at-size').value}%`));
  document.fonts?.ready.then(() => ed.redraw());
  const pv = ed.preview;
  let dragging = false;
  const move = (e: PointerEvent) => { const r = pv.getBoundingClientRect(); pos = { x: Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)), y: Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)) }; ed.redraw(); };
  pv.addEventListener('pointerdown', (e) => { dragging = true; pv.setPointerCapture(e.pointerId); move(e); });
  pv.addEventListener('pointermove', (e) => dragging && move(e));
  pv.addEventListener('pointerup', () => (dragging = false));
  pv.addEventListener('pointercancel', () => (dragging = false));
  pv.style.cursor = 'move';
  // Fonts load on first use; redraw once each finishes
  $('at-font').addEventListener('change', () => { const [wt, fam] = $('at-font').value.split('|'); document.fonts?.load(`${wt}40px ${fam}`).then(() => ed.redraw()); });
</script>
