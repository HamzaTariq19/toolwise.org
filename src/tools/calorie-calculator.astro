---
import CalcLayout from '../components/CalcLayout.astro';
import BodyInputs from '../components/BodyInputs.astro';
import { CAL_DEFAULT as d } from '../lib/calorie';
---
<CalcLayout id="cal">
  <Fragment slot="inputs">
    <BodyInputs id="cal" />
    <div><label for="cal-act" class="label">Activity level</label>
      <select id="cal-act" class="select">
        <option value="1.2">Little or no exercise</option><option value="1.375">Light: exercise 1 to 3 days a week</option><option value="1.55" selected>Moderate: exercise 3 to 5 days a week</option><option value="1.725">Active: hard exercise 6 to 7 days a week</option><option value="1.9">Very active: physical job and daily training</option>
      </select></div>
  </Fragment>
  <Fragment slot="results">
    <div data-ok>
      <p class="text-sm font-medium text-muted">To maintain your weight</p>
      <p class="mt-1 text-4xl font-extrabold tracking-tight tabular"><span data-r="main">{d.main}</span> <span class="text-xl font-semibold text-muted">kcal / day</span></p>
      <p class="mt-1 text-[0.9375rem] text-muted" data-r="sub">{d.sub}</p>
      <table class="mt-5 w-full text-[0.9375rem]"><tbody class="divide-y divide-[var(--border)] tabular" data-r="goals" set:html={d.goals}></tbody></table>
      <p class="mt-3 text-sm text-muted" data-r="note">{d.note}</p>
    </div>
    <div data-empty class="py-8 text-center text-muted" hidden>Enter your details to estimate your daily calories.</div>
    <p class="alert alert-error" data-msg hidden role="alert"></p>
  </Fragment>
</CalcLayout>
<script>
  import { live, resultsUi, body, val } from '../lib/calc';
  import { calorieView } from '../lib/calorie';
  const root = document.getElementById('cal')!, ui = resultsUi(root);
  function calc() {
    const b = body('cal');
    if (!(b.cm > 0) || !(b.kg > 0) || !(b.age > 0)) return ui.empty();
    if (b.age < 18 || b.age > 100) return ui.fail('This calculator is designed for adults aged 18 to 100. Children and teens have different needs; ask a doctor or dietitian.');
    if (b.cm < 120 || b.cm > 230) return ui.fail('Please check your height.');
    if (b.kg < 30 || b.kg > 300) return ui.fail('Please check your weight.');
    const v = calorieView({ ...b, act: Number(val('cal-act')) });
    ui.show(); ui.set('main', v.main); ui.set('sub', v.sub); ui.html('goals', v.goals); ui.set('note', v.note);
  }
  live(root.querySelector('[data-inputs]')!, calc);
</script>
