---
import Icon from '../components/Icon.astro';
import CurrencySelect from '../components/CurrencySelect.astro';
import { debtRowsHtml, DEFAULT_DEBTS } from '../lib/debt-rows';
---
<div id="ds" class="space-y-5">
  <div class="card p-4 sm:p-5">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-base font-semibold">Your debts</h2><CurrencySelect id="ds-cur" /></div>
    <div class="mt-3 hidden grid-cols-[1fr_7rem_5rem_7rem_2.75rem] gap-2 px-1 text-sm font-semibold text-muted md:grid"><span>Name</span><span>Balance</span><span>APR %</span><span>Minimum / mo</span><span></span></div>
    <ul class="mt-2 space-y-3 md:space-y-2" data-rows set:html={debtRowsHtml(DEFAULT_DEBTS)}></ul>
    <button type="button" class="btn btn-secondary mt-3" data-add><Icon name="Plus" size={18} />Add debt</button>
  </div>
  <div class="grid gap-5 md:grid-cols-2 md:items-start">
    <div class="card space-y-4 p-5">
      <div><label for="ds-extra" class="label">Extra you can pay each month</label><div class="input-group"><span class="addon addon-left" data-sym>$</span><input id="ds-extra" class="input tabular" inputmode="decimal" value="200" /></div><p class="hint">On top of all the minimum payments.</p></div>
      <fieldset><legend class="label">Method</legend>
        <div class="segmented"><label><input type="radio" name="ds-m" value="snowball" checked /><span>Snowball (smallest balance first)</span></label><label><input type="radio" name="ds-m" value="avalanche" /><span>Avalanche (highest rate first)</span></label></div>
      </fieldset>
    </div>
    <section class="card p-5" aria-live="polite">
      <div data-ok>
        <p class="text-sm font-medium text-muted">Debt-free in</p>
        <p class="mt-1 text-4xl font-extrabold tracking-tight" data-r="main"></p>
        <p class="mt-1 text-[0.9375rem] text-muted" data-r="sub"></p>
        <dl class="mt-4 grid grid-cols-2 gap-3">
          <div class="stat"><dt class="stat-label">Total interest</dt><dd class="text-lg font-bold tabular" data-r="int"></dd></div>
          <div class="stat"><dt class="stat-label">Interest saved</dt><dd class="text-lg font-bold tabular text-success" data-r="saved"></dd></div>
        </dl>
        <p class="mt-4 text-sm font-semibold">Payoff order</p>
        <ol class="mt-2 space-y-1.5 text-[0.9375rem]" data-r="order"></ol>
        <p class="mt-3 text-sm text-muted" data-r="compare"></p>
      </div>
      <div data-empty class="py-8 text-center text-muted" hidden>Add at least one debt with a balance and minimum payment.</div>
      <p class="alert alert-error" data-msg hidden role="alert"></p>
    </section>
  </div>
</div>
<script>
  import { DEFAULT_DEBTS, debtRowsHtml, type Debt } from '../lib/debt-rows';
  import { esc } from '../lib/ui';
  import { bindCurrency, resultsUi } from '../lib/calc';
  import { num, money, store } from '../lib/ui';
  const root = document.getElementById('ds')!, ui = resultsUi(root), rowsEl = root.querySelector<HTMLElement>('[data-rows]')!;
  const cur = bindCurrency(document.getElementById('ds-cur') as HTMLSelectElement, () => calc());
  let debts: Debt[] = store.get('tw-debts', DEFAULT_DEBTS.map((d) => ({ ...d })));
  function render() {
    rowsEl.innerHTML = debtRowsHtml(debts);
    calc();
  }
  function simulate(list: { name: string; bal: number; r: number; min: number }[], extra: number, order: 'snowball' | 'avalanche' | 'min') {
    const ds = list.map((d) => ({ ...d })), paid: { name: string; month: number }[] = [];
    const budget = ds.reduce((s, d) => s + d.min, 0) + (order === 'min' ? 0 : extra);
    let month = 0, interest = 0;
    while (ds.some((d) => d.bal > 0.005) && month < 1200) {
      month++;
      ds.forEach((d) => { if (d.bal > 0) { const i = d.bal * d.r; d.bal += i; interest += i; } });
      let left = budget;
      ds.forEach((d) => { if (d.bal > 0) { const p = Math.min(d.min, d.bal); d.bal -= p; left -= p; } });
      // Everything left goes to the target debt, then the next one
      const targets = ds.filter((d) => d.bal > 0.005).sort((a, b) => (order === 'avalanche' ? b.r - a.r || a.bal - b.bal : a.bal - b.bal));
      for (const t of targets) { if (left <= 0) break; const p = Math.min(left, t.bal); t.bal -= p; left -= p; }
      ds.forEach((d) => { if (d.bal <= 0.005 && !paid.some((p) => p.name === d.name)) { d.bal = 0; paid.push({ name: d.name, month }); } });
    }
    return { month, interest, paid, stuck: month >= 1200 };
  }
  const dur = (n: number) => { const y = Math.floor(n / 12), m = n % 12; return [y ? `${y} yr` : '', m ? `${m} mo` : ''].filter(Boolean).join(' ') || '0 mo'; };
  function calc() {
    store.set('tw-debts', debts);
    const c = cur(); root.querySelectorAll('[data-sym]').forEach((e) => (e.textContent = c || '#'));
    const list = debts.map((d, i) => ({ name: d.name.trim() || `Debt ${i + 1}`, bal: num(d.bal), r: num(d.apr) / 100 / 12, min: num(d.min) })).filter((d) => d.bal > 0);
    if (!list.length) return ui.empty();
    const bad = list.find((d) => !(d.min > 0) || !(d.r >= 0));
    if (bad) return ui.fail(`Enter the interest rate and minimum payment for “${bad.name}”.`);
    const extra = Math.max(0, num((document.getElementById('ds-extra') as HTMLInputElement).value) || 0);
    const method = (root.querySelector('input[name=ds-m]:checked') as HTMLInputElement).value as 'snowball' | 'avalanche';
    const plan = simulate(list, extra, method), base = simulate(list, 0, 'min'), other = simulate(list, extra, method === 'snowball' ? 'avalanche' : 'snowball');
    if (plan.stuck) return ui.fail('With these payments the debts never get paid off, because the interest is larger than the payments. Increase the minimum or extra payments.');
    ui.show();
    ui.set('main', dur(plan.month)); ui.set('sub', `${plan.month} months with ${money(extra, c)} extra each month`);
    ui.set('int', money(plan.interest, c, 0));
    ui.set('saved', base.stuck ? 'Large' : money(Math.max(0, base.interest - plan.interest), c, 0));
    ui.html('order', plan.paid.map((p, i) => `<li class="flex justify-between gap-2"><span>${i + 1}. ${esc(p.name)}</span><span class="text-muted tabular">month ${p.month}</span></li>`).join(''));
    const diff = other.interest - plan.interest;
    ui.set('compare', `${base.stuck ? 'Paying only the minimums would never clear these debts.' : `Paying only the minimums would take ${dur(base.month)}.`} The ${method === 'snowball' ? 'avalanche' : 'snowball'} method would ${Math.abs(diff) < 1 ? 'cost the same' : diff > 0 ? `cost ${money(diff, c, 0)} more in interest` : `save ${money(-diff, c, 0)} in interest`}.`);
  }
  rowsEl.addEventListener('input', (e) => { const t = e.target as HTMLInputElement, li = t.closest<HTMLElement>('li'); if (!li || !t.dataset.f) return; (debts[Number(li.dataset.i)] as Record<string, string>)[t.dataset.f] = t.value; calc(); });
  rowsEl.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-del]'); if (b) { debts.splice(Number(b.closest<HTMLElement>('li')!.dataset.i), 1); if (!debts.length) debts.push({ name: '', bal: '', apr: '', min: '' }); render(); } });
  root.querySelector('[data-add]')!.addEventListener('click', () => { debts.push({ name: '', bal: '', apr: '', min: '' }); render(); rowsEl.querySelector<HTMLInputElement>('li:last-child input')?.focus(); });
  root.addEventListener('change', (e) => { if (!(e.target as HTMLElement).closest('[data-rows]')) calc(); });
  document.getElementById('ds-extra')!.addEventListener('input', calc);
  render();
</script>
