---
import Icon from '../components/Icon.astro';
---
<div id="ps" class="space-y-4">
  <div class="card space-y-3 p-4 sm:p-5">
    <label for="ps-in" class="label">Password to check</label>
    <div class="relative -mt-1">
      <input id="ps-in" class="input mono !min-h-[52px] pr-14 text-lg" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-1p-ignore placeholder="Type a password" maxlength="256" />
      <button type="button" class="btn btn-ghost btn-sm absolute right-1.5 top-1/2 -translate-y-1/2 !px-2.5" data-eye aria-pressed="false" aria-label="Show password"><Icon name="Eye" size={18} /></button>
    </div>
    <p class="flex items-start gap-2 text-sm text-success"><Icon name="ShieldCheck" size={16} class="mt-0.5 flex-none" /><span>Checked only on your device. Your password is never sent, saved or logged. You can even disconnect from the internet and it still works.</span></p>
  </div>
  <section class="card p-5 sm:p-6" data-result aria-live="polite">
    <div class="flex items-end justify-between gap-3"><p class="text-3xl font-extrabold" data-label>Start typing</p><p class="text-sm text-subtle tabular" data-bits></p></div>
    <div class="mt-3 grid grid-cols-5 gap-1.5" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <span class="h-2.5 rounded-full bg-surface-2" data-seg={i}></span>)}</div>
    <dl class="mt-5 grid gap-2 sm:grid-cols-2" data-times hidden>
      <div class="stat"><dt class="stat-label">If a website's password list leaks (well protected)</dt><dd class="text-lg font-bold" data-t="slow"></dd></div>
      <div class="stat"><dt class="stat-label">If it leaks (poorly protected, fast hardware)</dt><dd class="text-lg font-bold" data-t="fast"></dd></div>
      <div class="stat"><dt class="stat-label">Guessing on a login page (rate limited)</dt><dd class="text-lg font-bold" data-t="online"></dd></div>
      <div class="stat"><dt class="stat-label">Length</dt><dd class="text-lg font-bold tabular" data-t="len"></dd></div>
    </dl>
    <div class="mt-5" data-partsbox hidden><p class="text-sm font-semibold text-muted">What an attacker would notice</p><div class="mt-2 flex flex-wrap gap-1.5" data-parts></div></div>
    <ul class="mt-5 space-y-1.5" data-warn></ul>
    <ul class="mt-3 space-y-1.5 text-muted" data-tips></ul>
  </section>
  <div class="grid gap-2 sm:grid-cols-4" data-checks aria-label="Character types">
    {[['len', '12+ characters'], ['lower', 'Lowercase letters'], ['upper', 'Capital letters'], ['num', 'Numbers'], ['sym', 'Symbols or spaces']].slice(0, 5).map(([k, l]) => <p class="flex items-center gap-2 rounded-lg bg-surface-2 px-3 py-2 text-sm" data-c={k}><span class="font-bold" data-mark>○</span>{l}</p>)}
  </div>
  <p class="text-sm text-muted">Need a strong one? Use the <a class="font-semibold text-[var(--brand-link)] underline" href="/password-generator">Password Generator</a>.</p>
</div>
<script>
  import { estimate, score, LABELS, crackTime, RATES, feedback, type Kind } from '../lib/password-strength';
  import { esc } from '../lib/ui';
  const root = document.getElementById('ps')!, q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const input = q<HTMLInputElement>('#ps-in');
  const COLORS = ['#dc2626', '#ea580c', '#ca8a04', '#16a34a', '#15803d'];
  const KIND: Record<Kind, string> = { common: 'Common password', word: 'Word or name', sequence: 'Sequence', repeat: 'Repeat', keyboard: 'Keyboard pattern', year: 'Year', date: 'Date', random: 'Random characters' };
  let showing = false;
  function run() {
    const pw = input.value;
    const segs = root.querySelectorAll<HTMLElement>('[data-seg]');
    const checks: Record<string, boolean> = { len: [...pw].length >= 12, lower: /[a-z]/.test(pw), upper: /[A-Z]/.test(pw), num: /\d/.test(pw), sym: /[^A-Za-z0-9]/.test(pw) };
    root.querySelectorAll<HTMLElement>('[data-c]').forEach((el) => { const ok = checks[el.dataset.c!]; el.querySelector('[data-mark]')!.textContent = ok ? '✓' : '○'; el.classList.toggle('text-success', ok); });
    if (!pw) {
      q('[data-label]').textContent = 'Start typing'; q('[data-label]').style.color = ''; q('[data-bits]').textContent = '';
      segs.forEach((s) => (s.style.background = '')); q('[data-times]').hidden = true; q('[data-partsbox]').hidden = true; q('[data-warn]').innerHTML = ''; q('[data-tips]').innerHTML = ''; return;
    }
    const { log, parts } = estimate(pw), sc = score(log, [...pw].length), { warn, tips } = feedback(pw, parts, sc);
    q('[data-label]').textContent = LABELS[sc]; q('[data-label]').style.color = COLORS[sc];
    q('[data-bits]').textContent = `about 10^${Math.round(log)} guesses`;
    segs.forEach((s, i) => (s.style.background = i <= sc ? COLORS[sc] : ''));
    q('[data-times]').hidden = false;
    q('[data-t=slow]').textContent = crackTime(log, RATES.offlineSlow); q('[data-t=fast]').textContent = crackTime(log, RATES.offlineFast);
    q('[data-t=online]').textContent = crackTime(log, RATES.online); q('[data-t=len]').textContent = `${[...pw].length} characters`;
    const notable = parts.filter((p) => p.kind !== 'random');
    q('[data-partsbox]').hidden = !notable.length;
    q('[data-parts]').innerHTML = parts.map((p) => `<span class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-sm ${p.kind === 'random' ? 'bg-surface-2 text-muted' : 'bg-danger-soft text-danger'}"><span class="mono font-semibold">${showing ? esc(p.token) : '•'.repeat(Math.min([...p.token].length, 12))}</span><span class="text-xs">${KIND[p.kind]}</span></span>`).join('');
    q('[data-warn]').innerHTML = warn.map((w) => `<li class="flex gap-2 text-[0.9375rem] font-medium text-danger"><span aria-hidden="true">!</span><span>${esc(w)}</span></li>`).join('');
    q('[data-tips]').innerHTML = tips.map((t) => `<li class="flex gap-2 text-[0.9375rem]"><span aria-hidden="true">→</span><span>${esc(t)}</span></li>`).join('');
  }
  input.addEventListener('input', run);
  q('[data-eye]').addEventListener('click', (e) => {
    showing = !showing; input.type = showing ? 'text' : 'password';
    const b = e.currentTarget as HTMLElement; b.setAttribute('aria-pressed', String(showing)); b.setAttribute('aria-label', showing ? 'Hide password' : 'Show password'); run(); input.focus();
  });
  // Clear the password when leaving the page so it isn't restored from the back/forward cache
  window.addEventListener('pagehide', () => { input.value = ''; });
  run();
</script>
