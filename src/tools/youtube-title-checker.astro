---
import { titleView, DEFAULT_TITLE } from '../lib/yt-title';
const v0 = titleView(DEFAULT_TITLE, '');
---
<div id="yt" class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:items-start">
  <div class="card space-y-4 p-5 sm:p-6">
    <div><div class="flex justify-between"><label for="yt-t" class="label">Video title</label><span class="text-sm font-semibold tabular" data-count>{v0.count}</span></div>
      <textarea id="yt-t" class="textarea !min-h-24 text-lg" maxlength="150">{DEFAULT_TITLE}</textarea>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-2"><div class="h-full rounded-full" data-bar style={`width:${v0.width};background:${v0.color}`}></div></div>
      <p class="hint">YouTube allows up to 100 characters. About 60 to 70 show in search results before being cut off.</p></div>
    <div><label for="yt-kw" class="label">Main keyword (optional)</label><input id="yt-kw" class="input" placeholder="e.g. budget" /></div>
    <ul class="space-y-1.5 text-[0.9375rem]" data-checks aria-live="polite" set:html={v0.checks}></ul>
  </div>
  <div class="space-y-4">
    <section><h2 class="mb-2 text-sm font-semibold text-muted">Search results (desktop)</h2><div class="flex gap-3 rounded-lg bg-white p-3"><div class="aspect-video w-40 flex-none rounded-lg bg-[#e5e5e5]"></div><div class="min-w-0"><p class="line-clamp-2 text-[18px] leading-6 text-[#0f0f0f] [overflow-wrap:anywhere]" data-p>{DEFAULT_TITLE}</p><p class="mt-1 text-xs text-[#606060]">Your Channel · 12K views · 2 days ago</p></div></div></section>
    <section><h2 class="mb-2 text-sm font-semibold text-muted">Home feed (phone)</h2><div class="w-full max-w-[360px] rounded-lg bg-white"><div class="aspect-video rounded-t-lg bg-[#e5e5e5]"></div><div class="flex gap-3 p-3"><div class="h-9 w-9 flex-none rounded-full bg-[#d9d9d9]"></div><div class="min-w-0"><p class="line-clamp-2 text-[15px] font-medium leading-5 text-[#0f0f0f] [overflow-wrap:anywhere]" data-p>{DEFAULT_TITLE}</p><p class="mt-1 text-xs text-[#606060]">Your Channel · 12K views</p></div></div></div></section>
    <section><h2 class="mb-2 text-sm font-semibold text-muted">Suggested videos sidebar</h2><div class="flex max-w-md gap-2 rounded-lg bg-white p-2"><div class="aspect-video w-36 flex-none rounded-lg bg-[#e5e5e5]"></div><p class="line-clamp-2 text-[14px] font-medium leading-5 text-[#0f0f0f] [overflow-wrap:anywhere]" data-p>{DEFAULT_TITLE}</p></div></section>
  </div>
</div>
<script>
  import { titleView } from '../lib/yt-title';
  const root = document.getElementById('yt')!, t = document.getElementById('yt-t') as HTMLTextAreaElement, kw = document.getElementById('yt-kw') as HTMLInputElement;
  function run() {
    const v = titleView(t.value, kw.value);
    root.querySelector('[data-count]')!.textContent = v.count;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!; bar.style.width = v.width; bar.style.background = v.color;
    root.querySelectorAll<HTMLElement>('[data-p]').forEach((e) => (e.textContent = v.s || 'Your video title'));
    root.querySelector('[data-checks]')!.innerHTML = v.checks;
  }
  root.addEventListener('input', run); run();
</script>
