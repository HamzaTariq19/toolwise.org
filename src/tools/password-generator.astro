---
import Icon from '../components/Icon.astro';
const opts = [['upper', 'Uppercase (A–Z)', true], ['lower', 'Lowercase (a–z)', true], ['digits', 'Numbers (0–9)', true], ['symbols', 'Symbols (!@#$…)', true], ['similar', 'Avoid look-alikes (0/O, 1/l/I)', false]] as const;
---
<div id="pg" class="space-y-5">
  <div class="card p-5 sm:p-6">
    <div class="flex items-center gap-2 rounded-xl border border-line-strong bg-surface-2 p-2 pl-4">
      <output class="mono min-w-0 flex-1 break-all text-xl font-semibold sm:text-2xl" data-pw aria-live="polite" aria-label="Generated password"></output>
      <button type="button" class="btn btn-ghost h-11 w-11 flex-none !p-0" data-regen aria-label="Generate a new password" title="New password"><Icon name="RefreshCw" size={20} /></button>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <div class="flex h-2 flex-1 gap-1" aria-hidden="true">{[0, 1, 2, 3].map(() => <span class="flex-1 rounded-full bg-surface-2" data-seg></span>)}</div>
      <span class="w-44 text-right text-sm font-semibold" data-strength>&nbsp;</span>
    </div>
    <button type="button" class="btn btn-primary btn-lg mt-5 w-full sm:w-auto" data-copy><Icon name="Copy" size={18} /><span data-label>Copy password</span></button>
  </div>
  <div class="card space-y-5 p-5 sm:p-6">
    <div>
      <div class="flex items-center justify-between"><label for="pg-len" class="label !mb-0">Length</label><output class="tabular text-lg font-bold" data-len>16</output></div>
      <input id="pg-len" type="range" min="6" max="64" value="16" class="mt-2 h-11 w-full accent-[var(--brand)]" />
    </div>
    <fieldset class="grid gap-1 sm:grid-cols-2">
      <legend class="label">Include</legend>
      {opts.map(([k, l, on]) => (
        <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" class="h-5 w-5 accent-[var(--brand)]" data-opt={k} checked={on} />{l}</label>
      ))}
    </fieldset>
    <p class="alert alert-error" data-error hidden role="alert"><span data-msg></span></p>
  </div>
</div>
<script>
  import { copyText, showError } from '../lib/ui';
  const root = document.getElementById('pg')!;
  const len = document.getElementById('pg-len') as HTMLInputElement;
  const SETS = { upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', lower: 'abcdefghijklmnopqrstuvwxyz', digits: '0123456789', symbols: '!@#$%^&*()-_=+[]{};:,.?/~' };
  const SIMILAR = /[O0Il1|]/g;
  const opt = (k: string) => root.querySelector<HTMLInputElement>(`[data-opt=${k}]`)!.checked;
  let pw = '';

  /** Unbiased random integer below n using the Web Crypto API */
  function rand(n: number) {
    const buf = new Uint32Array(1), limit = Math.floor(0x100000000 / n) * n;
    do crypto.getRandomValues(buf); while (buf[0] >= limit);
    return buf[0] % n;
  }

  function generate() {
    const sets = (Object.keys(SETS) as (keyof typeof SETS)[]).filter(opt).map((k) => (opt('similar') ? SETS[k].replace(SIMILAR, '') : SETS[k]));
    const err = root.querySelector<HTMLElement>('[data-error]')!;
    if (!sets.length) { showError(err, 'Choose at least one type of character.'); return; }
    showError(err, null);
    const n = Number(len.value);
    const all = sets.join('');
    // One character from each chosen set, the rest from all, then shuffle
    const chars = sets.map((s) => s[rand(s.length)]);
    while (chars.length < n) chars.push(all[rand(all.length)]);
    for (let i = chars.length - 1; i > 0; i--) { const j = rand(i + 1); [chars[i], chars[j]] = [chars[j], chars[i]]; }
    pw = chars.slice(0, n).join('');
    root.querySelector('[data-pw]')!.textContent = pw;
    root.querySelector('[data-len]')!.textContent = String(n);
    const bits = n * Math.log2(all.length);
    const level = bits < 40 ? 0 : bits < 60 ? 1 : bits < 80 ? 2 : 3;
    const labels = ['Weak', 'Fair', 'Strong', 'Very strong'], colors = ['#dc2626', '#f59e0b', '#16a34a', '#15803d'];
    root.querySelectorAll<HTMLElement>('[data-seg]').forEach((s, i) => (s.style.background = i <= level ? colors[level] : ''));
    root.querySelector('[data-strength]')!.textContent = `${labels[level]} · ${Math.round(bits)} bits`;
  }
  len.addEventListener('input', generate);
  root.querySelectorAll('[data-opt]').forEach((c) => c.addEventListener('change', generate));
  root.querySelector('[data-regen]')!.addEventListener('click', generate);
  root.querySelector('[data-copy]')!.addEventListener('click', (e) => copyText(pw, e.currentTarget as HTMLElement));
  generate();
</script>
