---
import Icon from '../components/Icon.astro';
import Dropzone from '../components/Dropzone.astro';
import TaskProgress from '../components/TaskProgress.astro';
import FfmpegNote from '../components/FfmpegNote.astro';
import ClipRange from '../components/ClipRange.astro';
---
<div id="vg" class="space-y-4">
  <p class="alert alert-error" data-unsupported hidden role="alert"><Icon name="CircleAlert" size={18} class="mt-0.5 flex-none" /><span>This browser can't run the video tools. Please use the latest Chrome, Edge, Firefox or Safari.</span></p>
  <Dropzone id="vg-drop" accept="video/*,.mkv,.mov,.m4v,.avi,.wmv,.flv,.3gp,.ts,.mts" formats="MP4, MOV, WebM, MKV and more" maxLabel="1 GB" icon="FileVideo" label="Choose video" />
  <p class="alert alert-error" data-error hidden role="alert"><Icon name="CircleAlert" size={18} class="mt-0.5 flex-none" /><span data-msg></span></p>
  <section class="card space-y-4 p-4 sm:p-5" data-opts hidden>
    <div class="flex items-start gap-3"><div class="min-w-0 flex-1"><p class="truncate font-semibold" data-name></p><p class="text-sm text-muted" data-meta></p></div><button type="button" class="btn btn-ghost btn-sm" data-change>Change</button></div>
    <p class="alert alert-info" data-nopreview hidden><Icon name="Info" size={18} class="mt-0.5 flex-none" /><span>Your browser can't play this format, so there's no preview. Type the start and end times instead.</span></p>
    <ClipRange id="vg-clip" />
    <p class="hint -mt-2">GIFs can be up to 30 seconds long. Short clips of 2 to 6 seconds work best.</p>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div><label for="vg-w" class="label">Width</label><select id="vg-w" class="select"><option value="320">320 px</option><option value="480" selected>480 px</option><option value="640">640 px</option><option value="800">800 px</option></select></div>
      <div><label for="vg-fps" class="label">Smoothness</label><select id="vg-fps" class="select"><option value="10">10 fps</option><option value="15" selected>15 fps</option><option value="20">20 fps</option><option value="25">25 fps</option></select></div>
      <div><label for="vg-c" class="label">Colors</label><select id="vg-c" class="select"><option value="256" selected>256 (best)</option><option value="128">128</option><option value="64">64 (smaller)</option></select></div>
      <div><label for="vg-loop" class="label">Repeat</label><select id="vg-loop" class="select"><option value="0" selected>Loop forever</option><option value="-1">Play once</option></select></div>
    </div>
    <p class="text-sm text-muted" data-est></p>
    <button type="button" class="btn btn-primary btn-lg w-full sm:w-auto" data-go><Icon name="Film" size={18} />Make GIF</button>
  </section>
  <TaskProgress id="vg-task" />
  <section class="card space-y-4 p-4 sm:p-5" data-result hidden aria-live="polite">
    <div class="flex items-center gap-2 text-success"><Icon name="CircleCheck" size={22} /><p class="font-semibold text-[var(--text)]" data-rsum></p></div>
    <p class="text-sm text-muted" data-rnote></p>
    <img alt="Your animated GIF" class="mx-auto max-h-[60vh] max-w-full rounded-xl" data-gif />
    <div class="flex flex-col gap-3 sm:flex-row"><button type="button" class="btn btn-primary btn-lg" data-dl><Icon name="Download" size={18} />Download GIF</button><button type="button" class="btn btn-secondary btn-lg" data-edit>Change settings</button><button type="button" class="btn btn-ghost btn-lg" data-again>Another video</button></div>
  </section>
  <FfmpegNote />
</div>
<script>
  import { initDropzone } from '../lib/dropzone';
  import { taskProgress } from '../lib/task-progress';
  import { clipRange, fmtTime } from '../lib/clip-range';
  import { showError, formatBytes, baseName, downloadBlob } from '../lib/ui';
  import { ffmpegSupported, loadFFmpeg, probe, run, cancelFFmpeg, toBlob, sec, type Probe } from '../lib/ffmpeg';
  const root = document.getElementById('vg')!, q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const drop = q('#vg-drop'), opts = q('[data-opts]'), result = q('[data-result]'), err = q('[data-error]');
  const MAX = 30;
  const clip = clipRange(q('#vg-clip'), { maxLength: MAX, initialLength: 5, onChange: () => estimate() });
  let file: File | null = null, info: Probe | null = null, out: { blob: Blob; name: string } | null = null, cancelled = false, url = '';
  const task = taskProgress(q('#vg-task'), () => { cancelled = true; cancelFFmpeg(); task.hide(); if (file && info) opts.hidden = false; else drop.hidden = false; showError(err, 'Cancelled.'); });
  if (!ffmpegSupported()) { q('[data-unsupported]').hidden = false; drop.hidden = true; }
  const width = () => Math.min(+q<HTMLSelectElement>('#vg-w').value, info?.video?.w ?? 9999);
  function estimate() {
    if (!info?.video) return;
    const w = width(), h = Math.round((w * info.video.h) / info.video.w), frames = (clip.end - clip.start) * +q<HTMLSelectElement>('#vg-fps').value;
    const bytes = w * h * frames * 0.32 * (+q<HTMLSelectElement>('#vg-c').value / 256) ** 0.35; // rough guide for typical video
    q('[data-est]').textContent = `About ${w} × ${h} px, ${Math.round(frames)} frames, roughly ${formatBytes(bytes)}. GIFs are much larger than videos; lower the width or smoothness for a smaller file.`;
  }
  ['#vg-w', '#vg-fps', '#vg-c'].forEach((s) => q(s).addEventListener('change', estimate));
  async function pick(f: File) {
    file = f; out = null; cancelled = false; result.hidden = true; drop.hidden = true; showError(err, null);
    task.show('Getting the video tools ready…');
    try {
      await loadFFmpeg(task.download('video tools'));
      task.set('Reading the video…', null, '');
      info = await probe(f);
      if (!info.video) throw new Error('This file has no video track.');
      q('[data-name]').textContent = f.name;
      q('[data-meta]').textContent = `${formatBytes(f.size)} · ${fmtTime(info.duration)} · ${info.video.w} × ${info.video.h}`;
      await clip.load(f, info.duration); if (!clip.duration) clip.setDuration(info.duration);
      q('[data-nopreview]').hidden = clip.previewable(); estimate();
      task.hide(); opts.hidden = false;
    } catch (e) { if (cancelled) return; task.hide(); drop.hidden = false; opts.hidden = true; file = null; showError(err, (e as Error).message || 'Something went wrong.'); }
  }
  q('[data-go]').addEventListener('click', async () => {
    if (!file || !info?.video) return;
    const a = clip.start, len = clip.end - clip.start;
    if (len < 0.2) return showError(err, 'Choose a section of at least a fifth of a second.');
    cancelled = false; opts.hidden = true; showError(err, null);
    const fps = q<HTMLSelectElement>('#vg-fps').value, colors = q<HTMLSelectElement>('#vg-c').value;
    const graph = `fps=${fps},scale=${width()}:-2:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=${colors}:stats_mode=diff[p];[s1][p]paletteuse=dither=sierra2_4a:diff_mode=rectangle`;
    task.show('Making your GIF…');
    try {
      const data = await run(file, ['-ss', sec(a), '-t', sec(len), '-i', '{in}', '-filter_complex', graph, '-loop', q<HTMLSelectElement>('#vg-loop').value, 'out.gif'], 'out.gif', len, (p) => task.set('Making your GIF…', p));
      out = { blob: toBlob(data, 'image/gif'), name: `${baseName(file.name)}.gif` };
      task.hide(); result.hidden = false;
      q('[data-rsum]').textContent = `${out.name} · ${fmtTime(len)} · ${formatBytes(out.blob.size)}`;
      q('[data-rnote]').textContent = out.blob.size > 8 * 1024 * 1024 ? 'This GIF is over 8 MB, which some apps and sites reject. Try a smaller width, fewer frames per second or a shorter clip.' : '';
      URL.revokeObjectURL(url); url = URL.createObjectURL(out.blob); q<HTMLImageElement>('[data-gif]').src = url;
    } catch (e) { if (cancelled) return; task.hide(); opts.hidden = false; showError(err, (e as Error).message); }
  });
  q('[data-dl]').addEventListener('click', () => out && downloadBlob(out.blob, out.name));
  q('[data-edit]').addEventListener('click', () => { result.hidden = true; opts.hidden = false; });
  const reset = () => { file = null; info = null; out = null; result.hidden = true; opts.hidden = true; drop.hidden = false; showError(err, null); clip.clear(); q<HTMLImageElement>('[data-gif]').removeAttribute('src'); };
  q('[data-again]').addEventListener('click', reset); q('[data-change]').addEventListener('click', reset);
  initDropzone(drop, { accept: ['video/*', '.mkv', '.mov', '.m4v', '.avi', '.wmv', '.flv', '.3gp', '.ts', '.mts', '.webm'], maxBytes: 1024 ** 3, onFiles: (f) => pick(f[0]), onError: (m) => showError(err, m || null) });
</script>
