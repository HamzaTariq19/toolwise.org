---
import PdfOptionsTool from '../components/PdfOptionsTool.astro';
import Icon from '../components/Icon.astro';
---
<PdfOptionsTool id="pp2" icon="FileLock2" action="Protect PDF">
  <div>
    <label for="pp2-pw" class="label">Password</label>
    <div class="relative"><input id="pp2-pw" type="password" class="input pr-12" autocomplete="new-password" /><button type="button" class="btn btn-ghost absolute right-0.5 top-0.5 h-10 w-10 !p-0" data-show aria-label="Show password"><Icon name="Eye" size={18} /></button></div>
    <div class="mt-2 flex h-1.5 gap-1" aria-hidden="true">{[0, 1, 2, 3].map(() => <span class="flex-1 rounded-full bg-surface-2" data-seg></span>)}</div>
    <p class="hint" data-strength>Use at least 8 characters. Longer is stronger.</p>
  </div>
  <div><label for="pp2-pw2" class="label">Repeat password</label><input id="pp2-pw2" type="password" class="input" autocomplete="new-password" /></div>
  <fieldset class="space-y-1">
    <legend class="label">After opening, people can</legend>
    <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="pp2-print" class="h-5 w-5 accent-[var(--brand)]" checked />Print the document</label>
    <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="pp2-copy" class="h-5 w-5 accent-[var(--brand)]" checked />Copy text and images</label>
    <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="pp2-edit" class="h-5 w-5 accent-[var(--brand)]" />Edit the document</label>
  </fieldset>
  <p class="alert alert-info text-sm"><Icon name="TriangleAlert" size={18} class="mt-0.5 flex-none" /><span>Write your password down. If you forget it, nobody, including toolwise, can open the file again. The PDF is encrypted with AES-256.</span></p>
</PdfOptionsTool>
<script>
  import { initOptionsTool } from '../lib/pdf-options-tool';
  import { loadPdfLibDoc } from '../lib/pdf';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const pw = $('pp2-pw');
  document.querySelector('#pp2 [data-show]')!.addEventListener('click', (e) => {
    const show = pw.type === 'password'; pw.type = $('pp2-pw2').type = show ? 'text' : 'password';
    (e.currentTarget as HTMLElement).setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });
  pw.addEventListener('input', () => {
    const p = pw.value, kinds = [/[a-z]/, /[A-Z]/, /\d/, /[^A-Za-z0-9]/].filter((r) => r.test(p)).length;
    const lvl = !p ? -1 : p.length < 8 ? 0 : p.length < 12 && kinds < 3 ? 1 : p.length < 16 && kinds < 4 ? 2 : 3;
    const colors = ['#dc2626', '#f59e0b', '#16a34a', '#15803d'];
    document.querySelectorAll<HTMLElement>('#pp2 [data-seg]').forEach((s, i) => (s.style.background = i <= lvl ? colors[lvl] : ''));
    document.querySelector('#pp2 [data-strength]')!.textContent = lvl < 0 ? 'Use at least 8 characters. Longer is stronger.' : ['Too short: use at least 8 characters.', 'Fair. Adding length or symbols makes it stronger.', 'Strong password.', 'Very strong password.'][lvl];
  });
  initOptionsTool('pp2', {
    outSuffix: 'protected',
    process: async ({ bytes }) => {
      const p = pw.value;
      if (p.length < 4) throw new Error('Choose a password of at least 4 characters (8 or more is recommended).');
      if (p !== $('pp2-pw2').value) throw new Error('The two passwords do not match. Type them again.');
      await loadPdfLibDoc(bytes); // friendly error for damaged or already-protected files
      const { PDFDocument } = await import('@cantoo/pdf-lib');
      const doc = await PDFDocument.load(bytes, { updateMetadata: false });
      // A random owner password stops anyone with the open password from simply removing the restrictions
      const owner = Array.from(crypto.getRandomValues(new Uint8Array(24)), (b) => b.toString(16).padStart(2, '0')).join('');
      const edit = $('pp2-edit').checked;
      doc.encrypt({
        userPassword: p, ownerPassword: owner,
        permissions: { printing: $('pp2-print').checked ? 'highResolution' : false, copying: $('pp2-copy').checked, modifying: edit, annotating: edit, fillingForms: true, contentAccessibility: true, documentAssembly: edit },
      });
      return { bytes: await doc.save(), note: 'Encrypted with AES-256' };
    },
  });
</script>
