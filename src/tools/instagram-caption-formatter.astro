---
import Icon from '../components/Icon.astro';
import { formatCaption, DEFAULT_CAPTION } from '../lib/ig-caption';
const r0 = formatCaption(DEFAULT_CAPTION, false, true);
---
<div id="ig" class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:items-start">
  <div class="card space-y-4 p-4 sm:p-5">
    <label for="ig-in" class="label">Your caption</label>
    <textarea id="ig-in" class="textarea -mt-2 !min-h-[260px]" placeholder="Write your caption with empty lines between paragraphs…">{DEFAULT_CAPTION}</textarea>
    <div class="flex flex-wrap gap-x-6">
      <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="ig-blank" class="h-5 w-5 accent-[var(--brand)]" checked />Keep empty lines (invisible character)</label>
      <label class="flex min-h-11 items-center gap-3 text-[0.9375rem]"><input type="checkbox" id="ig-tags" class="h-5 w-5 accent-[var(--brand)]" />Move hashtags to the end</label>
    </div>
    <dl class="grid grid-cols-3 gap-2 text-sm" aria-live="polite">
      <div class="stat"><dt class="stat-label">Characters</dt><dd class="font-bold tabular" data-k="chars">{r0.stats.chars}</dd></div>
      <div class="stat"><dt class="stat-label">Hashtags</dt><dd class="font-bold tabular" data-k="tags">{r0.stats.tags}</dd></div>
      <div class="stat"><dt class="stat-label">Mentions</dt><dd class="font-bold tabular" data-k="mentions">{r0.stats.mentions}</dd></div>
    </dl>
    <ul class="space-y-1 text-sm" data-checks set:html={r0.checks}></ul>
  </div>
  <div class="space-y-4">
    <section><h2 class="mb-2 text-sm font-semibold text-muted">Preview</h2>
      <div class="rounded-lg border border-line bg-white p-4 text-[14px] leading-[18px] text-[#262626]"><p class="whitespace-pre-wrap break-words" data-preview set:html={r0.preview}></p></div>
      <p class="mt-1 text-xs text-subtle">The first part shows in the feed; the rest appears after "more".</p></section>
    <button type="button" class="btn btn-primary btn-lg w-full" data-copy><Icon name="Copy" size={18} /><span data-label>Copy formatted caption</span></button>
  </div>
</div>
<script>
  import { copyText } from '../lib/ui';
  import { formatCaption } from '../lib/ig-caption';
  const root = document.getElementById('ig')!, ta = document.getElementById('ig-in') as HTMLTextAreaElement, q = (s: string) => root.querySelector<HTMLElement>(s)!;
  let result = '';
  function run() {
    const r = formatCaption(ta.value, (document.getElementById('ig-tags') as HTMLInputElement).checked, (document.getElementById('ig-blank') as HTMLInputElement).checked);
    result = r.result;
    q('[data-k=chars]').textContent = r.stats.chars; q('[data-k=tags]').textContent = r.stats.tags; q('[data-k=mentions]').textContent = r.stats.mentions;
    q('[data-checks]').innerHTML = r.checks;
    q('[data-preview]').innerHTML = r.preview;
  }
  root.addEventListener('input', run); root.addEventListener('change', run);
  q('[data-copy]').addEventListener('click', (e) => copyText(result, e.currentTarget as HTMLElement));
  run();
</script>
