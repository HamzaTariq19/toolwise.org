---
import Dropzone from '../components/Dropzone.astro';
import Icon from '../components/Icon.astro';
---
<div id="cp2" class="space-y-5">
  <div data-step="pick"><Dropzone id="cp2-drop" accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif,.heic,.heif" formats="JPG, PNG, WebP or HEIC" maxLabel="50 MB" label="Choose image" icon="Pipette" /></div>
  <div class="alert alert-error" data-error hidden role="alert"><span data-msg></span></div>
  <div data-step="pickcolor" class="grid gap-5 md:grid-cols-[minmax(0,1fr)_300px] md:items-start" hidden>
    <div class="card p-3 sm:p-4">
      <div class="relative flex justify-center" data-stage>
        <canvas data-img class="block h-auto max-h-[70vh] max-w-full cursor-crosshair touch-none rounded-md" aria-label="Your image. Tap or click anywhere to pick a color." role="img"></canvas>
        <canvas data-loupe width="120" height="120" class="pointer-events-none absolute hidden h-[120px] w-[120px] rounded-full border-4 border-white shadow-lg"></canvas>
      </div>
      <p class="mt-2 text-center text-sm text-subtle">Tap or click anywhere on the image. Drag to fine-tune.</p>
    </div>
    <div class="card space-y-4 p-5 md:sticky md:top-24" aria-live="polite">
      <div class="flex items-center gap-3"><span class="h-16 w-16 flex-none rounded-xl border border-line" data-swatch style="background:#888"></span><div><p class="text-sm text-muted">Picked color</p><p class="mono text-2xl font-bold" data-hex>–</p></div></div>
      <ul class="space-y-2" data-codes></ul>
      <div><p class="label">Main colors in this image</p><div class="flex flex-wrap gap-2" data-palette></div></div>
      <div data-hist-wrap hidden><p class="label">Picked so far</p><div class="flex flex-wrap gap-2" data-hist></div></div>
      <button type="button" class="btn btn-secondary w-full" data-reset><Icon name="RotateCcw" size={18} />Choose another image</button>
    </div>
  </div>
</div>
<script>
  import { initDropzone } from '../lib/dropzone';
  import { decodeAny, fitWithin } from '../lib/image';
  import { copyText, showError } from '../lib/ui';
  const root = document.getElementById('cp2')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const cv = q<HTMLCanvasElement>('[data-img]'), loupe = q<HTMLCanvasElement>('[data-loupe]');
  const g = cv.getContext('2d', { willReadFrequently: true })!;
  const hist: string[] = [];
  const hex = (r: number, gg: number, b: number) => '#' + [r, gg, b].map((v) => v.toString(16).padStart(2, '0')).join('').toUpperCase();
  function hsl(r: number, gg: number, b: number) {
    r /= 255; gg /= 255; b /= 255; const mx = Math.max(r, gg, b), mn = Math.min(r, gg, b), l = (mx + mn) / 2; let h = 0, s = 0;
    if (mx !== mn) { const d = mx - mn; s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn); h = mx === r ? (gg - b) / d + (gg < b ? 6 : 0) : mx === gg ? (b - r) / d + 2 : (r - gg) / d + 4; h *= 60; }
    return `hsl(${Math.round(h)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
  }
  function show(r: number, gg: number, b: number, save: boolean) {
    const h = hex(r, gg, b);
    q('[data-swatch]').style.background = h; q('[data-hex]').textContent = h;
    q('[data-codes]').innerHTML = [h, `rgb(${r}, ${gg}, ${b})`, hsl(r, gg, b)].map((v) => `<li class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-1.5"><code class="mono text-sm">${v}</code><button type="button" class="btn btn-ghost btn-sm" data-copy="${v}"><span data-label>Copy</span></button></li>`).join('');
    if (save && hist[0] !== h) { hist.unshift(h); hist.splice(12); q('[data-hist-wrap]').hidden = false; q('[data-hist]').innerHTML = hist.map((c) => `<button type="button" class="h-9 w-9 rounded-lg border border-line" style="background:${c}" data-pick="${c}" title="${c}" aria-label="Use ${c}"></button>`).join(''); }
  }
  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement, c = t.closest<HTMLElement>('[data-copy]'), p = t.closest<HTMLElement>('[data-pick]');
    if (c) copyText(c.dataset.copy!, c);
    if (p) { const n = parseInt(p.dataset.pick!.slice(1), 16); show(n >> 16, (n >> 8) & 255, n & 255, false); }
  });
  function sample(e: PointerEvent, save: boolean) {
    const r = cv.getBoundingClientRect();
    const x = Math.floor(((e.clientX - r.left) / r.width) * cv.width), y = Math.floor(((e.clientY - r.top) / r.height) * cv.height);
    if (x < 0 || y < 0 || x >= cv.width || y >= cv.height) return;
    const d = g.getImageData(x, y, 1, 1).data; show(d[0], d[1], d[2], save);
    // Magnifier
    const lg = loupe.getContext('2d')!; lg.imageSmoothingEnabled = false; lg.clearRect(0, 0, 120, 120);
    lg.drawImage(cv, x - 7, y - 7, 15, 15, 0, 0, 120, 120);
    lg.strokeStyle = '#fff'; lg.lineWidth = 2; lg.strokeRect(56, 56, 8, 8); lg.strokeStyle = '#000'; lg.lineWidth = 1; lg.strokeRect(55, 55, 10, 10);
    const st = q('[data-stage]').getBoundingClientRect();
    loupe.style.left = `${e.clientX - st.left - 60}px`; loupe.style.top = `${e.clientY - st.top - 140}px`; loupe.classList.remove('hidden');
  }
  let down = false;
  cv.addEventListener('pointerdown', (e) => { down = true; cv.setPointerCapture(e.pointerId); sample(e, false); });
  cv.addEventListener('pointermove', (e) => down && sample(e, false));
  cv.addEventListener('pointerup', (e) => { down = false; sample(e, true); loupe.classList.add('hidden'); });
  cv.addEventListener('pointercancel', () => { down = false; loupe.classList.add('hidden'); });
  function palette() {
    // Count colors in coarse buckets on a small copy, then take the most common distinct ones
    const s = document.createElement('canvas'), k = Math.min(1, 120 / Math.max(cv.width, cv.height));
    s.width = Math.max(1, cv.width * k); s.height = Math.max(1, cv.height * k);
    const sg = s.getContext('2d')!; sg.drawImage(cv, 0, 0, s.width, s.height);
    const d = sg.getImageData(0, 0, s.width, s.height).data, m = new Map<number, [number, number, number, number]>();
    for (let i = 0; i < d.length; i += 4) { if (d[i + 3] < 128) continue; const key = ((d[i] >> 4) << 8) | ((d[i + 1] >> 4) << 4) | (d[i + 2] >> 4); const e = m.get(key) ?? [0, 0, 0, 0]; e[0] += d[i]; e[1] += d[i + 1]; e[2] += d[i + 2]; e[3]++; m.set(key, e); }
    const picked: number[][] = [];
    for (const [, [r, gg, b, n]] of [...m].sort((a, b2) => b2[1][3] - a[1][3])) {
      const c = [r / n, gg / n, b / n].map(Math.round);
      if (picked.every((p) => Math.hypot(p[0] - c[0], p[1] - c[1], p[2] - c[2]) > 48)) picked.push(c);
      if (picked.length === 8) break;
    }
    q('[data-palette]').innerHTML = picked.map(([r, gg, b]) => { const h = hex(r, gg, b); return `<button type="button" class="h-9 w-9 rounded-lg border border-line" style="background:${h}" data-pick="${h}" title="${h}" aria-label="Use ${h}"></button>`; }).join('');
  }
  q('[data-reset]').addEventListener('click', () => { q('[data-step=pickcolor]').hidden = true; q('[data-step=pick]').hidden = false; });
  initDropzone(document.getElementById('cp2-drop')!, {
    accept: ['image/jpeg', 'image/png', 'image/webp', 'image/gif', '.jpg', '.jpeg', '.png', '.webp', '.gif', '.heic', '.heif'], maxBytes: 50 * 1024 * 1024,
    onFiles: async ([f]) => {
      showError(q('[data-error]'), null);
      try {
        const img = await decodeAny(f), { width, height } = fitWithin(img.width, img.height, 2400, 2400);
        cv.width = width; cv.height = height; g.drawImage(img.source, 0, 0, width, height); img.close?.();
        q('[data-step=pick]').hidden = true; q('[data-step=pickcolor]').hidden = false;
        palette();
        const d = g.getImageData(width >> 1, height >> 1, 1, 1).data; show(d[0], d[1], d[2], false);
      } catch (e) { showError(q('[data-error]'), (e as Error).message); }
    },
    onError: (m) => showError(q('[data-error]'), m || null),
  });
</script>
