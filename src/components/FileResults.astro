---
import Icon from './Icon.astro';
interface Props { id: string; downloadLabel?: string }
const { id, downloadLabel = 'Download' } = Astro.props;
---
<div id={id} class="file-results">
  <div data-progress class="card p-6" hidden aria-live="polite">
    <p class="font-semibold" data-progress-label>Working…</p>
    <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-bar>
      <div class="h-full w-0 rounded-full bg-brand transition-[width] duration-200" data-progress-fill></div>
    </div>
  </div>

  <div data-done hidden>
    <div class="card overflow-hidden">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-line bg-success-soft px-5 py-4" data-summary-wrap>
        <Icon name="CircleCheck" size={22} class="text-success" />
        <p class="font-semibold" data-summary></p>
      </div>
      <ul class="divide-y divide-[var(--border)]" data-list></ul>
    </div>
    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-primary btn-lg sm:min-w-56" data-download>
        <Icon name="Download" size={20} /><span data-label>{downloadLabel}</span>
      </button>
      <button type="button" class="btn btn-secondary btn-lg" data-reset>
        <Icon name="RotateCcw" size={18} /> Start over
      </button>
    </div>
  </div>
</div>
