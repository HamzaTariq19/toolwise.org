---
// "Saved on this device only" notice for tools that keep data in localStorage.
import Icon from './Icon.astro';
interface Props { clearLabel?: string; what?: string }
const { clearLabel, what = 'Your work is' } = Astro.props;
---
<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-[10px] bg-surface-2 px-3.5 py-2.5 text-sm text-muted" data-local-note data-noprint>
  <p class="flex items-start gap-2"><Icon name="HardDrive" size={16} class="mt-0.5 flex-none" /><span>{what} saved only in this browser on this device. Nothing is uploaded. Clearing your browser data deletes it.</span></p>
  {clearLabel && <button type="button" class="btn btn-ghost btn-sm text-danger" data-local-clear><Icon name="Trash2" size={16} />{clearLabel}</button>}
</div>
