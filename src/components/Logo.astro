---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class={`inline-flex items-center gap-2 font-bold text-ink no-underline ${cls}`} aria-label="toolwise home">
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--brand)" />
    <path d="M9 11h14M16 11v12" stroke="#fff" stroke-width="3" stroke-linecap="round" />
    <circle cx="23" cy="21" r="2.4" fill="#fff" />
  </svg>
  <span class="text-[1.1875rem] tracking-tight">toolwise</span>
</a>
