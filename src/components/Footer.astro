---
import Logo from './Logo.astro';
import { categories } from '../data/categories';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-line bg-surface">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.2fr_2fr_1fr]">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-[0.9375rem] text-muted">
        Free, fast and private online tools. No signup. Your files are processed on your device and never uploaded.
      </p>
    </div>
    <nav aria-label="Categories">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-subtle">Categories</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-1 sm:grid-cols-3">
        {categories.map((c) => (
          <li><a href={`/category/${c.slug}`} class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">{c.short}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-subtle">toolwise</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-1 md:grid-cols-1">
        <li><a href="/about" class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">About</a></li>
        <li><a href="/contact" class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">Contact</a></li>
        <li><a href="/privacy-policy" class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">Privacy Policy</a></li>
        <li><a href="/terms" class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">Terms of Use</a></li>
        <li><a href="/disclaimer" class="inline-flex min-h-10 items-center text-[0.9375rem] text-muted no-underline hover:text-ink">Disclaimer</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="container-page py-5 text-sm text-subtle">© {year} toolwise.org. All tools are free to use.</p>
  </div>
</footer>
