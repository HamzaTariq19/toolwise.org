---
// Standard calculator result area: big headline value, stat grid slot, placeholder and error message.
// Starts in the result state: every calculator using it has default values, so this avoids a layout shift on load.
// main/sub: optional build-time values for the defaults, so the panel has its final height before the script runs.
interface Props { label: string; empty?: string; main?: string; sub?: string }
const { label, empty = 'Fill in the details to see your result.', main = '–', sub = '' } = Astro.props;
---
<div data-ok>
  <p class="text-sm font-medium text-muted">{label}</p>
  <p class="mt-1 text-4xl font-extrabold tracking-tight tabular" data-r="main">{main}</p>
  <p class="mt-1 text-[0.9375rem] text-muted" data-r="sub">{sub}</p>
  <slot />
</div>
<div data-empty class="py-8 text-center text-muted" hidden><p>{empty}</p></div>
<p class="alert alert-error" data-msg hidden role="alert"></p>
