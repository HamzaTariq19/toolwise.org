---
// Shared layout for page-level PDF tools: pick a PDF, work on page thumbnails, save.
import Dropzone from './Dropzone.astro';
import FileResults from './FileResults.astro';
import PdfPicked from './PdfPicked.astro';
import Icon from './Icon.astro';
interface Props { id: string; icon: string; action: string; hint: string; rangeLabel?: string }
const { id, icon, action, hint, rangeLabel } = Astro.props;
---
<div id={id} class="space-y-5">
  <div data-step="pick">
    <Dropzone id={`${id}-drop`} accept="application/pdf,.pdf" formats="PDF file" maxLabel="200 MB" label="Choose PDF file" icon={icon} />
  </div>
  <div class="alert alert-error" data-error hidden role="alert"><span data-msg></span></div>
  <div data-step="pages" class="card p-4 sm:p-6" hidden>
    <PdfPicked />
    <p class="mt-4 text-[0.9375rem] text-muted" data-hint>{hint}</p>
    <div class="mt-3 flex flex-wrap items-center gap-2" data-toolbar><slot name="toolbar" /></div>
    {rangeLabel && (
      <div class="mt-3 flex flex-wrap items-end gap-2">
        <div class="min-w-0 flex-1 sm:max-w-xs"><label for={`${id}-range`} class="label">{rangeLabel}</label><input id={`${id}-range`} class="input" placeholder="e.g. 1-3, 5" autocomplete="off" data-range /></div>
        <button type="button" class="btn btn-secondary" data-apply-range>Select</button>
      </div>
    )}
    <div class="mt-5 grid grid-cols-3 gap-3 min-[480px]:grid-cols-4 sm:grid-cols-5 lg:grid-cols-6" data-grid></div>
    <p class="alert alert-error mt-4" data-opt-error hidden role="alert"><span data-msg></span></p>
    <div class="sticky bottom-3 z-20 mt-5 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-primary btn-lg shadow-lg" data-run><Icon name={icon} size={18} /><span data-label>{action}</span></button>
      <button type="button" class="btn btn-secondary btn-lg bg-surface" data-cancel>Choose another file</button>
    </div>
  </div>
  <FileResults id={`${id}-results`} />
</div>
