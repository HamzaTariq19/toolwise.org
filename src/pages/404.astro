---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { popularTools, isLive } from '../lib/tools';
const picks = popularTools(30).filter(isLive).slice(0, 6);
---
<Base title="Page not found | toolwise" description="This page could not be found." noindex>
  <div class="container-page pt-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-subtle">Error 404</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">We could not find that page</h1>
    <p class="mx-auto mt-3 max-w-md text-lg text-muted">The link may be old or mistyped. Search for the tool you need, or pick a popular one below.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-primary" data-search-open>Search tools</button>
      <a href="/" class="btn btn-secondary">Go to homepage</a>
    </div>
  </div>
  {picks.length > 0 && (
    <div class="container-page mt-12">
      <ul class="grid grid-cols-1 gap-3 min-[520px]:grid-cols-2 lg:grid-cols-3">{picks.map((t) => <ToolCard tool={t} headingLevel="h2" />)}</ul>
    </div>
  )}
</Base>
